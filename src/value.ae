// TLA+ values. Every value is interned once and named by an i64 id. So values are equal exactly
// when their ids are, a set is its elements' sorted ids (one canonical form), and a state is an
// array of ids.
//
// * An id with the low bit set is an integer, n << 1 | 1, for |n| < 2^61. Arithmetic beyond that
//   is an error (TLC stops at 2^31).
// * Other ids are 2 * k, k a table index: a boolean, string, model value (a cfg constant's
//   value), set, or function. Records, tuples and sequences are functions, as in TLA+:
//   [a |-> 1] is the function on {"a"}, <<x, y>> the one on 1..2. So <<>> = [x \in {} |-> 0]
//   holds, as it must.
// * Some sets stay unexpanded: Nat, Int, STRING, SUBSET S, [S -> T], [a : S] and Seq(S).
//   Membership needs no expansion. Anything else (equality, enumeration, storing in a state)
//   expands finite ones and is an error for infinite ones.
// * Sorting by id is a total order, used for canonical sets. Printing sorts by value instead
//   (cmp), so 1..3 prints as {1, 2, 3}.

import { Map } from "std/containers";
import str from "std/string";

/// An evaluation error: the spec is wrong or outside the subset.
export failure EvalError { msg: string; }

/// A table entry's kind.
export enum Tag { Bool, Str, Model, Set, Func, Nat, Int, Strings, Pow, FnSet, RecSet, SeqSet }

/// A value in the table.
export struct VNode {
    export tag: Tag;
    export num: i64 = 0;            // A boolean's 0 or 1.
    export s: string = "";          // A string's or model value's text.
    export xs: i64[] = [];          // A set's elements, a function's domain, a record set's fields.
    export ys: i64[] = [];          // A function's values, a record set's sets.
    export a: i64 = 0;              // SUBSET a, [a -> b], Seq(a).
    export b: i64 = 0;
}

/// The table of values.
export struct Values {
    export nodes: VNode[] = [];
    slots: i64[] = [];              // Open-addressed index: 0 empty, k + 1 for nodes[k].
    count: i64 = 0;
}

export var vt: Values = Values {};

export let FALSE: i64 = 0;
export let TRUE: i64 = 2;
let max_int: i64 = 2305843009213693951;    // 2^61 - 1

fn node_hash(n: &VNode) -> i64 {
    var h: i64 = (n.tag as i64) *% 0x9E3779B97F4A7C15;
    h = (h ^ n.num) *% 0x100000001B3;
    h = (h ^ std::hash(&n.s)) *% 0x100000001B3;
    h = (h ^ std::hash(&n.xs)) *% 0x100000001B3;
    h = (h ^ std::hash(&n.ys)) *% 0x100000001B3;
    h = (h ^ n.a) *% 0x100000001B3;
    h = (h ^ n.b) *% 0x100000001B3;
    return h;
}

fn same(x: &VNode, y: &VNode) -> bool {
    return x.tag == y.tag && x.num == y.num && x.a == y.a && x.b == y.b && str::eq(x.s, y.s)
        && std::equal(&x.xs, &y.xs) && std::equal(&x.ys, &y.ys);
}

fn grow() -> void {
    var cap: i64 = vt.slots.len * 2;
    if (cap == 0) { cap = 1024; }
    rehash(cap);
}

// Rebuilds the index with cap slots (a power of two, room for every node).
fn rehash(cap: i64) -> void {
    var slots: i64[cap];
    for (let k: i64 in 0..vt.nodes.len) {
        var s: i64 = (node_hash(&vt.nodes[k]) >> 3) & (cap - 1);
        while (slots[s] != 0) { s = (s + 1) & (cap - 1); }
        slots[s] = k + 1;
    }
    vt.slots = slots;
}

/// n's id, interned if new.
export fn intern(n: VNode) -> i64 {
    if ((vt.count + 1) * 4 > vt.slots.len * 3) { grow(); }
    let mask: i64 = vt.slots.len - 1;
    var s: i64 = (node_hash(&n) >> 3) & mask;
    while (vt.slots[s] != 0) {
        let k: i64 = vt.slots[s] - 1;
        if (same(&vt.nodes[k], &n)) { return k * 2; }
        s = (s + 1) & mask;
    }
    vt.nodes.push(n);
    vt.count += 1;
    vt.slots[s] = vt.nodes.len;
    return (vt.nodes.len - 1) * 2;
}

/// Empties the table, then makes FALSE and TRUE (ids 0 and 2).
export fn reset() -> void {
    vt = Values {};
    intern(VNode { tag: Tag::Bool, num: 0 });
    intern(VNode { tag: Tag::Bool, num: 1 });
}

export fn is_int(v: i64) -> bool { return (v & 1) == 1; }
export fn int_of(v: i64) -> i64 { return v >> 1; }

export fn mk_int(n: i64) -> i64 | EvalError {
    if (n > max_int || n < -max_int) { fail EvalError { msg: "an integer past 2^61: \(n)" }; }
    return (n << 1) | 1;
}

// For small integers known to fit (indexes, lengths).
export fn small(n: i64) -> i64 { return (n << 1) | 1; }

export fn mk_bool(b: bool) -> i64 {
    if (b) { return TRUE; }
    return FALSE;
}

export fn mk_str(s: string) -> i64 { return intern(VNode { tag: Tag::Str, s: s }); }
export fn mk_model(s: string) -> i64 { return intern(VNode { tag: Tag::Model, s: s }); }

/// v's tag (integers have none: check is_int first).
export fn tag(v: i64) -> Tag { return vt.nodes[v >> 1].tag; }

export fn is_tag(v: i64, t: Tag) -> bool { return !is_int(v) && vt.nodes[v >> 1].tag == t; }

/// A copy of v's xs (a set's elements, a function's domain).
export fn xs(v: i64) -> i64[] { return std::copy(vt.nodes[v >> 1].xs); }

/// A copy of v's ys (a function's values).
export fn ys(v: i64) -> i64[] { return std::copy(vt.nodes[v >> 1].ys); }

export fn size(v: i64) -> i64 { return vt.nodes[v >> 1].xs.len; }

// Sorts ids in place (merge sort: std has no sort), keeping duplicates.
fn sort_ids(mut a: &i64[]) -> void {
    let n: i64 = a.len;
    if (n < 2) { return; }
    var sorted: bool = true;
    for (let i: i64 in 1..n) {
        if (a[i - 1] > a[i]) {
            sorted = false;
            break;
        }
    }
    if (sorted) { return; }
    var tmp: i64[n];
    var width: i64 = 1;
    while (width < n) {
        var lo: i64 = 0;
        while (lo < n) {
            var mid: i64 = lo + width;
            if (mid > n) { mid = n; }
            var hi: i64 = lo + 2 * width;
            if (hi > n) { hi = n; }
            var i: i64 = lo;
            var j: i64 = mid;
            var k: i64 = lo;
            while (i < mid && j < hi) {
                if (a[i] <= a[j]) {
                    tmp[k] = a[i];
                    i += 1;
                } else {
                    tmp[k] = a[j];
                    j += 1;
                }
                k += 1;
            }
            while (i < mid) {
                tmp[k] = a[i];
                i += 1;
                k += 1;
            }
            while (j < hi) {
                tmp[k] = a[j];
                j += 1;
                k += 1;
            }
            lo = hi;
        }
        for (let t: i64 in 0..n) { a[t] = tmp[t]; }
        width *= 2;
    }
}

/// The set of elems (any order, repeats allowed).
export fn mk_set(mut elems: i64[]) -> i64 {
    sort_ids(mut &elems);
    var out: i64[] = [];
    for (let i: i64 in 0..elems.len) {
        if (i == 0 || elems[i] != elems[i - 1]) { out.push(elems[i]); }
    }
    return intern(VNode { tag: Tag::Set, xs: out });
}

/// The set of elems, already sorted by id, no repeats.
export fn mk_set_sorted(elems: i64[]) -> i64 { return intern(VNode { tag: Tag::Set, xs: elems }); }

/// The function from dom (sorted by id, no repeats) to rng (rng[i] for dom[i]).
export fn mk_func_sorted(dom: i64[], rng: i64[]) -> i64 {
    return intern(VNode { tag: Tag::Func, xs: dom, ys: rng });
}

/// The function from dom to rng, any order; a repeated key is an error.
export fn mk_func(dom: &i64[], rng: &i64[]) -> i64 | EvalError {
    let n: i64 = dom.len;
    var idx: i64[] = [];
    for (let i: i64 in 0..n) { idx.push(i); }
    // Insertion-sort positions by key: domains are small.
    for (let i: i64 in 1..n) {
        var j: i64 = i;
        while (j > 0 && dom[idx[j - 1]] > dom[idx[j]]) {
            let t: i64 = idx[j];
            idx[j] = idx[j - 1];
            idx[j - 1] = t;
            j -= 1;
        }
    }
    var d: i64[] = [];
    var r: i64[] = [];
    for (let i: i64 in 0..n) {
        if (i > 0 && dom[idx[i]] == dom[idx[i - 1]]) {
            fail EvalError { msg: "a function with the key \(show(dom[idx[i]])) twice" };
        }
        d.push(dom[idx[i]]);
        r.push(rng[idx[i]]);
    }
    return mk_func_sorted(d, r);
}

/// The tuple (sequence) <<xs[0], xs[1], ...>>.
export fn mk_tuple(vals: i64[]) -> i64 {
    var d: i64[] = [];
    for (let i: i64 in 0..vals.len) { d.push(small(i + 1)); }
    return mk_func_sorted(d, vals);
}

/// The record [names[0] |-> vals[0], ...].
export fn mk_rec(names: &string[], vals: &i64[]) -> i64 | EvalError {
    var d: i64[] = [];
    for (let s: string in names) { d.push(mk_str(s)); }
    return mk_func(&d, vals);
}

/// Whether v is a set (expanded or not).
export fn is_set(v: i64) -> bool {
    if (is_int(v)) { return false; }
    return match (tag(v)) {
        Tag::Set | Tag::Nat | Tag::Int | Tag::Strings | Tag::Pow | Tag::FnSet | Tag::RecSet | Tag::SeqSet => true,
        _ => false,
    };
}

// key's position in the sorted ids, or -1.
export fn find(ids: &i64[], key: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = ids.len;
    while (lo < hi) {
        let mid: i64 = (lo + hi) / 2;
        if (ids[mid] < key) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if (lo < ids.len && ids[lo] == key) { return lo; }
    return -1;
}

/// Whether v's domain is 1..n: a sequence (or the empty function).
export fn is_seq(v: i64) -> bool {
    if (!is_tag(v, Tag::Func)) { return false; }
    let d: &i64[] = &vt.nodes[v >> 1].xs;
    for (let i: i64 in 0..d.len) {
        if (d[i] != small(i + 1)) { return false; }
    }
    return true;
}

/// f[x].
export fn apply(f: i64, x: i64) -> i64 | EvalError {
    if (!is_tag(f, Tag::Func)) { fail EvalError { msg: "applying \(show(f)), which is not a function" }; }
    let k: i64 = find(&vt.nodes[f >> 1].xs, x);
    if (k < 0) { fail EvalError { msg: "\(show(x)) is not in the domain of \(show(f))" }; }
    return vt.nodes[f >> 1].ys[k];
}

/// f[x], or none if x is outside f's domain (f must be a function).
export fn lookup(f: i64, x: i64) -> i64? {
    let k: i64 = find(&vt.nodes[f >> 1].xs, x);
    if (k < 0) { return none; }
    return vt.nodes[f >> 1].ys[k];
}

/// f with f[x] = v. If x is outside f's domain, f itself (as in TLA+).
export fn update(f: i64, x: i64, v: i64) -> i64 | EvalError {
    if (!is_tag(f, Tag::Func)) { fail EvalError { msg: "EXCEPT on \(show(f)), which is not a function" }; }
    let k: i64 = find(&vt.nodes[f >> 1].xs, x);
    if (k < 0) { return f; }
    if (vt.nodes[f >> 1].ys[k] == v) { return f; }
    var r: i64[] = ys(f);
    r[k] = v;
    return mk_func_sorted(xs(f), r);
}

/// x \in s.
export fn member(x: i64, s: i64) -> bool | EvalError {
    if (is_int(s)) { fail EvalError { msg: "\\in \(show(s)), which is not a set" }; }
    match (tag(s)) {
        Tag::Set => { return find(&vt.nodes[s >> 1].xs, x) >= 0; },
        Tag::Nat => { return is_int(x) && int_of(x) >= 0; },
        Tag::Int => { return is_int(x); },
        Tag::Strings => { return is_tag(x, Tag::Str); },
        Tag::Pow => {
            if (!is_set(x)) { return false; }
            let ex: i64 = expand(x)?;
            let base: i64 = vt.nodes[s >> 1].a;
            for (let e: i64 in xs(ex)) {
                if (!member(e, base)?) { return false; }
            }
            return true;
        },
        Tag::FnSet => {
            if (!is_tag(x, Tag::Func)) { return false; }
            let dom: i64 = expand(vt.nodes[s >> 1].a)?;
            let rng: i64 = vt.nodes[s >> 1].b;
            if (!std::equal(&vt.nodes[x >> 1].xs, &vt.nodes[dom >> 1].xs)) { return false; }
            for (let e: i64 in ys(x)) {
                if (!member(e, rng)?) { return false; }
            }
            return true;
        },
        Tag::RecSet => {
            if (!is_tag(x, Tag::Func)) { return false; }
            if (!std::equal(&vt.nodes[x >> 1].xs, &vt.nodes[s >> 1].xs)) { return false; }
            let sets: i64[] = ys(s);
            let vals: i64[] = ys(x);
            for (let i: i64 in 0..vals.len) {
                if (!member(vals[i], sets[i])?) { return false; }
            }
            return true;
        },
        Tag::SeqSet => {
            if (!is_seq(x)) { return false; }
            let base: i64 = vt.nodes[s >> 1].a;
            for (let e: i64 in ys(x)) {
                if (!member(e, base)?) { return false; }
            }
            return true;
        },
        _ => { fail EvalError { msg: "\\in \(show(s)), which is not a set" }; },
    }
}

fn mix(x: i64) -> i64 {
    var h: i64 = x *% 0x9E3779B97F4A7C15;
    h = h ^ ((h >> 31) & 0x1FFFFFFFF);
    h = h *% 0xBF58476D1CE4E5B9;
    h = h ^ ((h >> 29) & 0x7FFFFFFFF);
    return h;
}

// insertion-sorts a small array of hashes in place
fn sort_small(mut a: &i64[]) -> void {
    for (let i: i64 in 1..a.len) {
        var j: i64 = i;
        while (j > 0 && a[j - 1] > a[j]) {
            let t: i64 = a[j];
            a[j] = a[j - 1];
            a[j - 1] = t;
            j -= 1;
        }
    }
}

/// A 64-bit fingerprint of v with model values renamed by perm (a SYMMETRY permutation), without
/// building the renamed value: equal renamed values have equal fingerprints. It ignores ids
/// (strings and model values hash by text), so it survives compact. cache holds each value's
/// fingerprint under this perm.
export fn fingerprint(v: i64, perm: &Map(i64, i64), mut cache: &Map(i64, i64)) -> i64 {
    if (is_int(v)) { return mix(v); }
    if (let h = cache.get(v)) { return h; }
    var h: i64 = 0;
    match (tag(v)) {
        Tag::Model => { h = mix(std::hash(&vt.nodes[(perm.get(v) ?? v) >> 1].s) +% 7); },
        Tag::Str => { h = mix(std::hash(&vt.nodes[v >> 1].s) +% 11); },
        Tag::Bool => { h = mix(vt.nodes[v >> 1].num +% 3); },
        Tag::Set => {
            var hs: i64[] = [];
            for (let e: i64 in xs(v)) { hs.push(fingerprint(e, perm, cache)); }
            sort_small(mut &hs);
            h = 0x5E7;
            for (let x: i64 in &hs) { h = mix(h ^ x); }
        },
        Tag::Func => {
            var hs: i64[] = [];
            let d: i64[] = xs(v);
        }
    }
}

/// s's elements, for enumeration.
export fn elements(s: i64) -> i64[] | EvalError { return xs(expand(s)?); }

// A rank per kind, for a stable print order.
fn rank(v: i64) -> i64 {
    if (is_int(v)) { return 1; }
    return match (tag(v)) {
        Tag::Bool => 0,
        Tag::Str => 2,
        Tag::Model => 3,
        Tag::Func => 5,
        _ => 4,
    };
}

/// Compares a and b by value: integers by number, strings by text, sets and functions element-wise.
/// Only for printing.
export fn cmp(a: i64, b: i64) -> i64 {
    if (a == b) { return 0; }
    let ra: i64 = rank(a);
    let rb: i64 = rank(b);
    if (ra != rb) { return ra - rb; }
    if (is_int(a)) {
        if (int_of(a) < int_of(b)) { return -1; }
        return 1;
    }
    let x: &VNode = &vt.nodes[a >> 1];
    let y: &VNode = &vt.nodes[b >> 1];
    if (x.tag != y.tag) { return (x.tag as i64) - (y.tag as i64); }
    match (x.tag) {
        Tag::Bool => { return x.num - y.num; },
        Tag::Str | Tag::Model => { return str::cmp(x.s, y.s); },
        _ => {},
    }
    let xa: i64[] = sorted(&x.xs);
    let ya: i64[] = sorted(&y.xs);
    for (let i: i64 in 0..xa.len) {
        if (i >= ya.len) { return 1; }
        let c: i64 = cmp(xa[i], ya[i]);
        if (c != 0) { return c; }
    }
    if (xa.len < ya.len) { return -1; }
    if (x.tag == Tag::Func) {
        for (let i: i64 in 0..x.ys.len) {
            let c: i64 = cmp(lookup(a, xa[i]) ?? 0, lookup(b, xa[i]) ?? 0);
            if (c != 0) { return c; }
        }
    }
    return 0;
}

// ids sorted by value (insertion sort: for printing).
fn sorted(ids: &i64[]) -> i64[] {
    var a: i64[] = std::copy(*ids);
    for (let i: i64 in 1..a.len) {
        var j: i64 = i;
        while (j > 0 && cmp(a[j - 1], a[j]) > 0) {
            let t: i64 = a[j];
            a[j] = a[j - 1];
            a[j - 1] = t;
            j -= 1;
        }
    }
    return a;
}

fn quote(s: string) -> string {
    var out: string = "\"";
    for (let c: u8 in s) {
        let e: string = match (c) {
            '"' => "\\\"",
            '\\' => "\\\\",
            '\n' => "\\n",
            '\t' => "\\t",
            _ => "",
        };
        if (e.len > 0) {
            out = "\(out)\(e)";
        } else {
            out = "\(out)\(substr_byte(c))";
        }
    }
    return "\(out)\"";
}

fn substr_byte(c: u8) -> string {
    let one: u8[] = [c];
    return str::from_bytes(one);
}

fn join(parts: &string[], sep: string) -> string {
    var out: string = "";
    for (let i: i64, let p: string in parts) {
        if (i > 0) { out = "\(out)\(sep)"; }
        out = "\(out)\(p)";
    }
    return out;
}

/// v in TLA+ notation, as TLC prints it.
export fn show(v: i64) -> string {
    if (is_int(v)) { return "\(int_of(v))"; }
    let t: Tag = tag(v);
    match (t) {
        Tag::Bool => {
            if (v == TRUE) { return "TRUE"; }
            return "FALSE";
        },
        Tag::Str => { return quote(vt.nodes[v >> 1].s); },
        Tag::Model => { return vt.nodes[v >> 1].s; },
        Tag::Nat => { return "Nat"; },
        Tag::Int => { return "Int"; },
        Tag::Strings => { return "STRING"; },
        Tag::Pow => { return "SUBSET \(show(vt.nodes[v >> 1].a))"; },
        Tag::SeqSet => { return "Seq(\(show(vt.nodes[v >> 1].a)))"; },
        Tag::FnSet => { return "[\(show(vt.nodes[v >> 1].a)) -> \(show(vt.nodes[v >> 1].b))]"; },
        Tag::RecSet => {
            var parts: string[] = [];
            let d: i64[] = xs(v);
            let r: i64[] = ys(v);
            for (let i: i64 in 0..d.len) { parts.push("\(vt.nodes[d[i] >> 1].s) : \(show(r[i]))"); }
            return "[\(join(&parts, ", "))]";
        },
        Tag::Set => {
            var parts: string[] = [];
            for (let e: i64 in sorted(&vt.nodes[v >> 1].xs)) { parts.push(show(e)); }
            return "{\(join(&parts, ", "))}";
        },
        Tag::Func => {
            let d: i64[] = xs(v);
            var parts: string[] = [];
            if (is_seq(v)) {
                for (let e: i64 in ys(v)) { parts.push(show(e)); }
                return "<<\(join(&parts, ", "))>>";
            }
            var record: bool = true;
        }
    }
}
