// tla's model checker: a breadth-first search of every state a spec can reach, as TLC does,
// checking each against the invariants.
//
// * As in TLC, a found state is kept as its fingerprint, parent and how it was reached; it is
//   kept whole (an interned tuple, value.ae) only while queued. Values held only by explored
//   states are freed now and then (value::compact). A violation is shown as the shortest
//   behavior leading to it, in TLC's wording and layout: the behavior is found again from the
//   initial states, each step the successor with the next fingerprint.
// * A state breaking a CONSTRAINT is checked against the invariants, but its successors are not
//   explored. (So a constraint bounds the search and can hide only states, never steps.)
// * Deadlock (a state with no successor) is an error unless CHECK_DEADLOCK FALSE, as in TLC.
// * PROPERTY: P ~> Q, []<>Q (TRUE ~> Q) or <>Q (Q eventually, from the initial states), P and Q
//   state predicates, under the SPECIFICATION's fairness (WF_vars(A), SF_vars(A), also under
//   \A). Checked as TLC does: the state graph is kept (each state's successors, which fairness
//   conditions each step is a step of, which are enabled where); the states still awaiting Q
//   (reached from one where P holds and Q doesn't, through states where Q doesn't) are split
//   into strongly connected components, each state able to stutter; a component a fair
//   behavior can stay in forever is a counterexample, shown as a behavior into it and around
//   it. WF holds in a component if its action is taken in it or disabled in one of its states;
//   SF, if taken or disabled in all of them (else the states where it's enabled are dropped
//   and the rest split again).
// * Exit codes are TLC's: 0 no error, 10 an ASSUME is false, 11 deadlock, 12 an invariant is
//   violated, 13 a temporal property is violated, 75 an evaluation error, 150 a spec or cfg
//   could not be read. tla adds 1: the search stopped at a limit (max_states, max_values)
//   before finishing, so a model too large for the machine stops with a message instead of
//   being killed.

import fs from "std/fs";
import { Map } from "std/containers";
import { Op, Node, Kind, Global, prog, sym, name, add, pos, glob } from "ast.ae";
import { parse, ParseError } from "parse.ae";
import { Cfg, CVal, CfgError, read_cfg } from "cfg.ae";
import { EvalError, reset, mk_int, mk_str, mk_model, mk_bool, mk_set, show, xs, ys, TRUE, vt, Tag, is_tag, elements, fingerprint, compact } from "value.ae";
import { cx, start, eval, initial, successors, successors_with, eval_with, holds, constant_node, reset_envs, where_at, value_roots, reroot } from "eval.ae";
import str from "std/string";
import process from "std/process";

/// What a check found.
export struct Report {
    export code: i64 = 0;
    export distinct: i64 = 0;           // Distinct states found.
    export generated: i64 = 0;          // States generated, including repeats.
    export depth: i64 = 0;              // Longest shortest path from an initial state, + 1.
    export out: string[] = [];          // Output: verdict, trace, counts.
}

/// How to check.
export struct Options {
    export spec: string;                // The .tla file.
    export cfg: string = "";            // The .cfg file; if "", the spec's name with .cfg.
    export deadlock: bool = true;       // false: never report deadlock (TLC's -deadlock).
    export progress: bool = false;      // Print progress while searching.
    export max_states: i64 = 1000000;   // Stop past this many distinct states,
    export max_values: i64 = 20000000;  // or this many values made (each ~100 bytes or more).
    export compact_at: i64 = 1000000;   // Free explored states' values at this many, then
                                        //   at twice as many as were kept (tests: 1, every step).
    export simulate: i64 = 0;           // > 0: that many random behaviors instead of a search,
    export depth: i64 = 100;            //   each at most this many steps,
    export seed: i64 = 1;               //   from this seed (same seed, same walks).
}

/// A fairness condition, one per instance: WF_vars(A) or SF_vars(A), with its \A's names bound.
struct Fairness {
    strong: bool = false;
    act: i64 = -1;                      // The action's node.
    syms: i64[] = [];
    vals: i64[] = [];                   // (let_go keeps these values and gives them new ids.)
    text: string = "";                  // How it's shown.
}

/// A temporal property: from each state where p holds, q eventually holds. p is -1 for TRUE
/// ([]<>Q), -2 for initial states only (<>Q).
struct Prop {
    name: string = "";
    p: i64 = -1;
    q: i64 = -1;
}

struct Search {
    states: i64[] = [];                 // In order found: the queue. (Not renamed, so each is a
                                        //   successor of its parent and a trace is a behavior,
                                        //   with or without SYMMETRY.) -1 once explored.
    fps: i64[] = [];                    // Each state's canonical form.
    parents: i64[] = [];
    depths: i64[] = [];
    seen: Map(i64, i64) = Map {};       // Each state's canonical form -> its index.
    perms: Map(i64, i64)[] = [];        // SYMMETRY's permutations (model value -> model value)
    caches: Map(i64, i64)[] = [];       //   and the fingerprints each made. Without SYMMETRY,
    sym: bool = false;                  //   just the identity.
    init: i64 = -1;                     // Init and Next, to rebuild a trace's behavior.
    act: i64 = -1;
    compact_at: i64 = 1000000;          // Free explored states' values past this many,
    compact_min: i64 = 1000000;         //   and at least this many (Options.compact_at).
    // The state graph for PROPERTY (live), by state, in explored order.
    live: bool = false;
    fairs: Fairness[] = [];
    props: Prop[] = [];
    succ: i64[][] = [];                 // Its successors (indices).
    steps: i64[][] = [];                // Per successor: fairness conditions it's a step of (bits).
    enabled: i64[] = [];                // The fairness conditions enabled in it (bits).
    pq: i64[] = [];                     // Bit 2i: props[i].p holds in it; bit 2i + 1: props[i].q.
    out: bool[] = [];                   // Outside the CONSTRAINT: not explored.
}

// st's canonical form: its least fingerprint under SYMMETRY's permutations (without SYMMETRY,
// its fingerprint), as in TLC: two states merge only if equal up to renaming or their
// fingerprints collide (the report gives the odds).
fn canonical(mut s: &Search, st: i64) -> i64 {
    var best: i64 = 9223372036854775807;
    for (let i: i64 in 0..s.perms.len) {
        let h: i64 = fingerprint(st, &s.perms[i], mut &s.caches[i]);
        if (h < best) { best = h; }
    }
    // caches only speed things up: empty them before they grow too large
    if (s.caches[0].len() > 4000000) {
        for (let i: i64 in 0..s.caches.len) { s.caches[i] = Map {}; }
    }
    return best;
}

fn say(mut r: &Report, line: string) -> void { r.out.push(line); }

// Frees values held only by explored states (value::compact). Kept and renumbered: queued
// states (from head on), the evaluator's values, and the model values SYMMETRY renames.
// Fingerprints are not ids, so they stay.
fn let_go(mut s: &Search, head: i64) -> void {
    var roots: i64[] = [];
    for (let k: i64 in head..s.states.len) { roots.push(s.states[k]); }
    value_roots(mut &roots);
    for (let j: i64 in 0..s.perms.len) {
        for (let i: i64 in 0..s.perms[j].cap()) {
            if (s.perms[j].full(i)) {
                roots.push(s.perms[j].entry(i).key);
                roots.push(s.perms[j].entry(i).val);
            }
        }
    }
    for (let f: &Fairness in &s.fairs) { for (let v: i64 in &f.vals) { roots.push(v); } }
    compact(mut &roots);
    var at: i64 = 0;
    for (let k: i64 in head..s.states.len) {
        s.states[k] = roots[at];
        at += 1;
    }
    at = reroot(&roots, at);
    for (let j: i64 in 0..s.perms.len) {
        var perm: Map(i64, i64) = Map {};
        for (let i: i64 in 0..s.perms[j].cap()) {
            if (s.perms[j].full(i)) {
                perm.put(roots[at], roots[at + 1]);
                at += 2;
            }
        }
        s.perms[j] = perm;
        s.caches[j] = Map {};
    }
    for (let i: i64 in 0..s.fairs.len) {
        for (let j: i64 in 0..s.fairs[i].vals.len) {
            s.fairs[i].vals[j] = roots[at];
            at += 1;
        }
    }
    s.compact_at = 2 * vt.nodes.len;
    if (s.compact_at < s.compact_min) { s.compact_at = s.compact_min; }
}

// The process's resident memory from /proc (Linux), else "".
fn rss() -> string {
    let st: string = fs::read_file("/proc/self/status") ?? "";
    var i: i64 = 0;
    while (i + 6 < st.len) {
        if (str::eq(st[i..i + 6], "VmRSS:")) {
            var j: i64 = i;
            while (j < st.len && st[j] != '\n') { j += 1; }
            return st[i..j];
        }
        i += 1;
    }
    return "";
}

// A node naming definition (or variable) s, to evaluate it.
// Whether n is a state predicate: no primes, UNCHANGED or temporal operators in it or in the
// definitions it uses (seen: definitions already checked).
fn state_predicate(n: i64, mut seen: &Map(i64, i64)) -> bool {
    if (n < 0) { return true; }
    let nd: Node = std::copy(prog.nodes[n]);
    match (nd.op) {
        Op::Prime | Op::Unchanged | Op::Box | Op::Diamond | Op::LeadsTo | Op::Fair | Op::ActSub => { return false; },
        _ => {},
    }
    if ((nd.op == Op::Global || nd.op == Op::Call) && !seen.has(nd.sym)) {
        seen.put(nd.sym, 1);
        let g: Global = glob(nd.sym);
        if (g.kind == Kind::Def && !state_predicate(g.body, seen)) { return false; }
    }
    for (let k: i64 in &nd.kids) { if (!state_predicate(k, seen)) { return false; } }
    return state_predicate(nd.a, seen) && state_predicate(nd.b, seen) && state_predicate(nd.c, seen);
}

// PROPERTY's graph: state st's successors (after, as found), which fairness conditions each
// step is a step of, which are enabled in st, and where each property's P and Q hold.
fn keep(mut s: &Search, st: i64, after: &i64[]) -> void | EvalError {
    let me: i64 = canonical(s, st);
    var succ: i64[] = [];
    for (let t: i64 in after) {
        if (let j = s.seen.get(canonical(s, t))) { succ.push(j); }
    }
    var steps: i64[succ.len];
    var en: i64 = 0;
    for (let i: i64 in 0..s.fairs.len) {
        let f: Fairness = std::copy(s.fairs[i]);
        successors_with(st, f.act, &f.syms, &f.vals)?;
        let to: i64[] = std::copy(cx.found);
        var hit: Map(i64, i64) = Map {};
        for (let t: i64 in &to) {
            let c: i64 = canonical(s, t);
            if (c != me) { hit.put(c, 1); }             // a step changes the state: <<A>>_vars
        }
        if (hit.len() > 0) { en = en | (1 << i); }
        for (let e: i64 in 0..succ.len) {
            if (hit.has(s.fps[succ[e]])) { steps[e] = steps[e] | (1 << i); }
        }
    }
    var pq: i64 = 0;
    for (let i: i64 in 0..s.props.len) {
        let p: i64 = s.props[i].p;
        if (p == -1 || (p >= 0 && holds(st, p)?)) { pq = pq | (1 << (2 * i)); }
        if (holds(st, s.props[i].q)?) { pq = pq | (1 << (2 * i + 1)); }
    }
    s.succ.push(succ);
    s.steps.push(std::copy(steps));
    s.enabled.push(en);
    s.pq.push(pq);
    s.out.push(false);
}

// Strongly connected components of the graph among states marked `stamp` in mark (Tarjan's,
// without recursion). Every state may stutter, so each is its own cycle.
fn components(s: &Search, nodes: &i64[], mark: &i64[], stamp: i64) -> i64[][] {
    let n: i64 = s.succ.len;
    var index: i64[n];
    var low: i64[n];
    var on: bool[n];
    var seen: bool[n];
    var stack: i64[] = [];
    var out: i64[][] = [];
    var count: i64 = 0;
    for (let root: i64 in nodes) {
        if (seen[root]) { continue; }
        // depth-first walk: each frame is a state and the next successor to visit
        var frames: i64[] = [root];
        var at: i64[] = [0];
        seen[root] = true;
        index[root] = count;
        low[root] = count;
        count += 1;
        stack.push(root);
        on[root] = true;
        while (frames.len > 0) {
            let u: i64 = frames[frames.len - 1];
            let e: i64 = at[at.len - 1];
            if (e < s.succ[u].len) {
                at[at.len - 1] = e + 1;
                let v: i64 = s.succ[u][e];
                if (mark[v] != stamp) { continue; }
                if (!seen[v]) {
                    seen[v] = true;
                    index[v] = count;
                    low[v] = count;
                    count += 1;
                    stack.push(v);
                    on[v] = true;
                    frames.push(v);
                    at.push(0);
                } else if (on[v] && index[v] < low[u]) {
                    low[u] = index[v];
                }
                continue;
            }
            frames.pop();
            at.pop();
            if (frames.len > 0) {
                let w: i64 = frames[frames.len - 1];
                if (low[u] < low[w]) { low[w] = low[u]; }
            }
            if (low[u] == index[u]) {
                var comp: i64[] = [];
                while (true) {
                    let x: i64 = stack.pop();
                    on[x] = false;
                    comp.push(x);
                    if (x == u) { break; }
                }
                out.push(comp);
            }
        }
    }
    return out;
}

// A component of the waiting states a fair behavior can stay in forever, or [] if none.
fn fair_component(s: &Search, comps: i64[][]) -> i64[] {
    let n: i64 = s.succ.len;
    var mark: i64[n];
    var stamp: i64 = 1000000;               // (component marks start past the waiting set's)
    var pending: i64[][] = comps;
    while (pending.len > 0) {
        let c: i64[] = pending.pop();
        stamp += 1;
        for (let u: i64 in &c) { mark[u] = stamp; }
        var fair: bool = true;
        var leave: i64 = 0;                 // SF conditions enabled in some states, never taken
        for (let f: i64 in 0..s.fairs.len) {
            let bit: i64 = 1 << f;
            var taken: bool = false;
            var some_on: bool = false;
            var some_off: bool = false;
            for (let u: i64 in &c) {
                if ((s.enabled[u] & bit) != 0) { some_on = true; } else { some_off = true; }
                for (let e: i64 in 0..s.succ[u].len) {
                    if (mark[s.succ[u][e]] == stamp && (s.steps[u][e] & bit) != 0) { taken = true; }
                }
            }
            if (taken) { continue; }
            if (!s.fairs[f].strong) {
                if (some_off) { continue; }
                fair = false;               // enabled throughout, never taken: no fair behavior stays
                break;
            }
            if (some_on) { leave = leave | bit; }
        }
        if (!fair) { continue; }
        if (leave == 0) { return c; }
        // SF: a staying behavior must avoid the states where it's enabled
        var rest: i64[] = [];
        stamp += 1;
        for (let u: i64 in &c) {
            if ((s.enabled[u] & leave) == 0) {
                rest.push(u);
                mark[u] = stamp;
            }
        }
        if (rest.len == 0) { continue; }
        for (let sub: i64[] in components(s, &rest, &mark, stamp)) { pending.push(std::copy(sub)); }
    }
    return [];
}

// Whether props[i] holds: no fair behavior from a state where its P holds and its Q doesn't
// stays forever where Q doesn't. If one does, it's shown.
fn holds_eventually(mut s: &Search, i: i64, mut r: &Report) -> bool | EvalError {
    let n: i64 = s.succ.len;
    let pbit: i64 = 1 << (2 * i);
    let qbit: i64 = 1 << (2 * i + 1);
    let p: i64 = s.props[i].p;
    var mark: i64[n];
    var pred: i64[n];
    var waiting: i64[] = [];
    for (let k: i64 in 0..n) {
        if (s.out[k] || (s.pq[k] & qbit) != 0) { continue; }
        var start: bool = (s.pq[k] & pbit) != 0;
        if (p == -2) { start = s.parents[k] < 0; }
        if (start) {
            mark[k] = 1;
            pred[k] = -1;
            waiting.push(k);
        }
    }
    var at: i64 = 0;
    while (at < waiting.len) {
        let u: i64 = waiting[at];
        at += 1;
        for (let v: i64 in &s.succ[u]) {
            if (v >= n || mark[v] == 1 || s.out[v] || (s.pq[v] & qbit) != 0) { continue; }
            mark[v] = 1;
            pred[v] = u;
            waiting.push(v);
        }
    }
    let c: i64[] = fair_component(s, components(s, &waiting, &mark, 1));
    if (c.len == 0) { return true; }
    say(r, "Error: Temporal properties were violated.");
    say(r, "Error: \(s.props[i].name): from a state where it starts waiting, a fair behavior never reaches what it waits for.");
    // into the component: the behavior to its first waiting state, then within waiting states
    var lead: i64[] = [];
    var k: i64 = c[0];
    while (k >= 0) {
        lead.push(k);
        k = pred[k];
    }
    let first: i64 = lead[lead.len - 1];
    var path: i64[] = [];
    var j: i64 = lead.len - 2;
    while (j >= 0) {
        path.push(lead[j]);
        j -= 1;
    }
    // around it: through each of its states, and through a step of each fairness condition
    // with a step in it (so the loop shown is a fair behavior, not just the component)
    var inc: bool[n];
    for (let u: i64 in &c) { inc[u] = true; }
    var stops: i64[] = [];                  // states to pass through, in order: a step is two
    for (let u: i64 in &c) { stops.push(u); }
    for (let f: i64 in 0..s.fairs.len) {
        let bit: i64 = 1 << f;
        var done: bool = false;
        for (let u: i64 in &c) {
            if (done) { break; }
            for (let e: i64 in 0..s.succ[u].len) {
                let v: i64 = s.succ[u][e];
                if (inc[v] && v != u && (s.steps[u][e] & bit) != 0) {
                    stops.push(u);
                    stops.push(-1 - v);     // the step itself: v right after u
                    done = true;
                    break;
                }
            }
        }
    }
    var ring: i64[] = [];
    var here: i64 = c[0];
    for (let t: i64 in 1..stops.len + 1) {
        var target_state: i64 = c[0];
        if (t < stops.len) { target_state = stops[t]; }
        if (target_state < 0) {             // take the step
            let v: i64 = -1 - target_state;
            ring.push(v);
            here = v;
            continue;
        }
        if (target_state == here) { continue; }
        for (let v: i64 in walk(s, here, target_state, &inc)) { ring.push(v); }
        here = target_state;
    }
    show_lasso(s, first, &path, &ring, r);
    if (s.fairs.len > 0) {
        say(r, "Under the fairness:");
        for (let f: &Fairness in &s.fairs) { say(r, "  \(f.text)"); }
    }
    return false;
}

// States after origin (excluded) on a shortest path to target_state, through states marked in inc.
fn walk(s: &Search, origin: i64, target_state: i64, inc: &bool[]) -> i64[] {
    let n: i64 = s.succ.len;
    var back: i64[n];
    var seen: bool[n];
    var q: i64[] = [origin];
    seen[origin] = true;
    var at: i64 = 0;
    var reached: bool = false;
    while (at < q.len && !reached) {
        let u: i64 = q[at];
        at += 1;
        for (let v: i64 in &s.succ[u]) {
            if (!inc[v] || seen[v]) { continue; }
            seen[v] = true;
            back[v] = u;
            q.push(v);
            if (v == target_state) {
                reached = true;
                break;
            }
        }
    }
    var out: i64[] = [];
    if (!reached) { return out; }
    var k: i64 = target_state;
    while (k != origin) {
        out.push(k);
        k = back[k];
    }
    var rev: i64[] = [];
    var i: i64 = out.len - 1;
    while (i >= 0) {
        rev.push(out[i]);
        i -= 1;
    }
    return rev;
}

// A counterexample in TLC's layout: the behavior to `first`, then `path`, then `ring` back to
// its start (an empty ring: stuttering there forever).
fn show_lasso(mut s: &Search, first: i64, path: &i64[], ring: &i64[], mut r: &Report) -> void {
    var states: i64[] = [];
    var labels: string[] = [];
    match (replay(s, first, mut &states, mut &labels)) {
        v => {},
        e: EvalError => {
            say(r, "Error: the behavior could not be found again: \(e.msg)");
            return;
        },
    }
    var idx: i64[] = [];
    var k: i64 = first;
    var chain: i64[] = [];
    while (k >= 0) {
        chain.push(k);
        k = s.parents[k];
    }
    var i: i64 = chain.len - 1;
    while (i >= 0) {
        idx.push(chain[i]);
        i -= 1;
    }
    let cycle_at: i64 = idx.len + path.len;     // the ring's start state: the last of path
    for (let x: i64 in path) { idx.push(x); }
    for (let x: i64 in ring) { idx.push(x); }
    // the rest, rebuilt: each the successor with the next state's canonical form
    while (states.len < idx.len) {
        let last: i64 = states[states.len - 1];
        match (successors(last, s.act)) {
            v => {},
            e: EvalError => {
                say(r, "Error: the behavior could not be found again: \(e.msg)");
                return;
            },
        }
        let choices: i64[] = std::copy(cx.found);
        let how: string[] = std::copy(cx.labels);
        let want: i64 = s.fps[idx[states.len]];
        var got: i64 = -1;
        for (let j: i64 in 0..choices.len) {
            if (canonical(s, choices[j]) == want) {
                got = j;
                break;
            }
        }
        if (got < 0) {
            say(r, "Error: the behavior could not be found again");
            return;
        }
        states.push(choices[got]);
        labels.push(std::copy(how[got]));
    }
    say(r, "Error: The behavior up to this point is:");
    let loop_from: i64 = cycle_at - 1;          // index in states where the ring begins
    for (let i2: i64 in 0..states.len) {
        var label: string = labels[i2];
        if (label.len == 0) { label = "Next"; }
        if (i2 == states.len - 1 && ring.len > 0) {
            say(r, "Back to state \(loop_from + 1): <\(label)>");
            say(r, "");
            break;
        }
        say(r, "State \(i2 + 1): <\(label)>");
        for (let l: string in show_state(states[i2])) { say(r, l); }
        say(r, "");
    }
    if (ring.len == 0) { say(r, "State \(states.len + 1): Stuttering"); }
}

fn ref(s: i64) -> i64 { return add(Node { op: Op::Global, sym: s }); }

fn cval(v: &CVal) -> i64 | EvalError {
    match (v.kind) {
        "num" => { return mk_int(v.num)?; },
        "str" => { return mk_str(v.text); },
        "bool" => { return mk_bool(v.num == 1); },
        "model" => { return mk_model(v.text); },
        _ => {},
    }
    var elems: i64[] = [];
    for (let e: &CVal in &v.elems) { elems.push(cval(e)?); }
    return mk_set(elems);
}

// The node of a parameterless definition named in the cfg as what.
fn named(n: string, what: string, mut r: &Report) -> i64 {
    let s: i64 = sym(n);
    if (let g = prog.globals.get(s)) {
        if (g.kind == Kind::Def && g.params.len == 0) { return ref(s); }
    }
    say(r, "Error: the \(what) \(n) is not a definition without parameters in the spec");
    r.code = 150;
    return -1;
}

// Init and Next from a SPECIFICATION Init /\ [][Next]_vars (/\ fairness).
// Whether n is fairness: WF_vars(A), SF_vars(A), a conjunction of them, or one under \A.
fn is_fairness(n: i64) -> bool {
    let op: Op = prog.nodes[n].op;
    if (op == Op::Fair) { return true; }
    if (op == Op::Forall) { return is_fairness(prog.nodes[n].b); }
    if (op == Op::And) {
        let kids: i64[] = std::copy(prog.nodes[n].kids);
        for (let k: i64 in &kids) { if (!is_fairness(k)) { return false; } }
        return true;
    }
    return false;
}

// Each instance of fairness n, its \A's names bound to every combination of their values.
fn expand_fairness(n: i64, syms: &i64[], vals: &i64[], mut out: &Fairness[]) -> void | EvalError {
    let op: Op = prog.nodes[n].op;
    if (op == Op::Fair) {
        let a: i64 = prog.nodes[n].a;
        var text: string = "WF";
        if (prog.nodes[n].num == 1) { text = "SF"; }
        var what: string = "at \(pos(a))";
        if (prog.nodes[a].op == Op::Global || prog.nodes[a].op == Op::Call) { what = name(prog.nodes[a].sym); }
        var bound: string = "";
        for (let i: i64 in 0..syms.len) {
            if (i > 0) { bound = "\(bound),"; }
            bound = "\(bound) \(name(syms[i])) = \(show(vals[i]))";
        }
        if (bound.len > 0) { what = "\(what):\(bound)"; }
        text = "\(text)(\(what))";
        out.push(Fairness { strong: prog.nodes[n].num == 1, act: a, syms: std::copy(*syms), vals: std::copy(*vals), text: text });
        return;
    }
    if (op == Op::And) {
        let kids: i64[] = std::copy(prog.nodes[n].kids);
        for (let k: i64 in &kids) { expand_fairness(k, syms, vals, out)?; }
        return;
    }
    let names: i64[] = std::copy(prog.nodes[n].syms);
    let sets: i64[] = std::copy(prog.nodes[n].kids);
    let body: i64 = prog.nodes[n].b;
    each_binding(&names, &sets, 0, body, syms, vals, out)?;
}

fn each_binding(names: &i64[], sets: &i64[], i: i64, body: i64, syms: &i64[], vals: &i64[], mut out: &Fairness[]) -> void | EvalError {
    if (i == names.len) {
        expand_fairness(body, syms, vals, out)?;
        return;
    }
    let set: i64 = eval_with(sets[i], syms, vals)?;
    for (let v: i64 in elements(set)?) {
        var more_syms: i64[] = std::copy(*syms);
        var more_vals: i64[] = std::copy(*vals);
        more_syms.push(names[i]);
        more_vals.push(v);
        each_binding(names, sets, i + 1, body, &more_syms, &more_vals, out)?;
    }
}

fn from_spec(n: string, mut r: &Report, mut init: &i64, mut act: &i64, mut fair: &i64[]) -> void {
    let s: i64 = sym(n);
    let g: Global = glob(s);
    if (g.kind != Kind::Def || g.params.len != 0) {
        say(r, "Error: the SPECIFICATION \(n) is not a definition without parameters in the spec");
        r.code = 150;
        return;
    }
    // Its conjuncts at any depth, including /\ Init /\ [][Next]_vars on one bullet-list line.
    var parts: i64[] = [];
    var todo: i64[] = [g.body];
    while (todo.len > 0) {
        let x: i64 = todo.pop();
        if (prog.nodes[x].op == Op::And) {
            let kids: i64[] = std::copy(prog.nodes[x].kids);
            var i: i64 = kids.len - 1;
            while (i >= 0) {
                todo.push(kids[i]);
                i -= 1;
            }
        } else {
            parts.push(x);
        }
    }
    for (let p: i64 in &parts) {
        let nd: &Node = &prog.nodes[p];
        if (nd.op == Op::Box && prog.nodes[nd.a].op == Op::ActSub) {
            if (*act >= 0) { break; }
            *act = prog.nodes[nd.a].a;
        } else if (is_fairness(p)) {
            // fairness constrains only infinite behaviors: kept for PROPERTY, ignored for safety
            fair.push(p);
        } else if (*init < 0) {
            *init = p;
        } else {
            *init = -2;
        }
    }
    if (*init < 0 || *act < 0) {
        say(r, "Error: the SPECIFICATION \(n) must be Init /\\ [][Next]_vars, with fairness if any");
        r.code = 150;
    }
}

fn show_state(st: i64) -> string[] {
    var lines: string[] = [];
    let vals: i64[] = ys(st);
    for (let i: i64 in 0..vals.len) { lines.push("/\\ \(name(prog.vars[i])) = \(show(vals[i]))"); }
    return lines;
}

// The behavior ending at state last, rebuilt (explored states aren't kept whole): from the
// initial states, each step the successor whose canonical form is the next state's. Its
// states go in states, how each was reached in labels.
fn replay(mut s: &Search, last: i64, mut states: &i64[], mut labels: &string[]) -> void | EvalError {
    var path: i64[] = [];
    var k: i64 = last;
    while (k >= 0) {
        path.push(k);
        k = s.parents[k];
    }
    reset_envs();
    initial(s.init)?;
    var choices: i64[] = std::copy(cx.found);
    var how: string[] = [];
    for (let c: i64 in &choices) { how.push("Initial predicate"); }
    var i: i64 = path.len - 1;
    while (i >= 0) {
        let want: i64 = s.fps[path[i]];
        var got: i64 = -1;
        for (let j: i64 in 0..choices.len) {
            if (canonical(s, choices[j]) == want) {
                got = j;
                break;
            }
        }
        if (got < 0) { fail EvalError { msg: "no successor has the next state's fingerprint" }; }
        states.push(choices[got]);
        labels.push(std::copy(how[got]));
        i -= 1;
        if (i >= 0) {
            successors(choices[got], s.act)?;
            choices = std::copy(cx.found);
            how = std::copy(cx.labels);
        }
    }
}

fn trace(mut s: &Search, last: i64, mut r: &Report) -> void {
    var states: i64[] = [];
    var labels: string[] = [];
    match (replay(s, last, mut &states, mut &labels)) {
        v => {},
        e: EvalError => {
            say(r, "Error: the behavior could not be found again: \(e.msg)");
            return;
        },
    }
    say(r, "Error: The behavior up to this point is:");
    for (let i: i64 in 0..states.len) {
        var label: string = labels[i];
        if (label.len == 0) { label = "Next"; }
        say(r, "State \(i + 1): <\(label)>");
        for (let l: string in show_state(states[i])) { say(r, l); }
        say(r, "");
    }
}

fn counts(s: &Search, mut r: &Report) -> void {
    r.distinct = s.states.len;
    var d: i64 = 0;
    for (let x: i64 in &s.depths) { if (x > d) { d = x; } }
    r.depth = d;
    say(r, "\(r.generated) states generated, \(r.distinct) distinct states found.");
    // TLC's optimistic estimate: n * m / 2^64, for n distinct of m generated
    let p: f64 = (r.distinct as f64) * (r.generated as f64) / 18446744073709551616.0;
    var how: string = "";
    if (s.sym) { how = ", up to SYMMETRY's renamings"; }
    say(r, "States are told apart by 64-bit fingerprints\(how): the chance of a collision is about \(p).");
    say(r, "The depth of the complete state graph search is \(r.depth).");
}

// Adds st (found from parent by label) if new, then checks the invariants. Returns false if
// one fails (r says which).
fn found(mut s: &Search, st: i64, parent: i64, label: string, invs: &i64[], inv_names: &string[], mut r: &Report) -> bool | EvalError {
    r.generated += 1;
    let c: i64 = canonical(s, st);
    if (s.seen.has(c)) { return true; }
    let k: i64 = s.states.len;
    s.seen.put(c, k);
    s.states.push(st);
    s.fps.push(c);
    s.parents.push(parent);
    var d: i64 = 1;
    if (parent >= 0) { d = s.depths[parent] + 1; }
    s.depths.push(d);
    for (let i: i64 in 0..invs.len) {
        if (!holds(st, invs[i])?) {
            say(r, "Error: Invariant \(inv_names[i]) is violated.");
            trace(s, k, r);
            r.code = 12;
            return false;
        }
    }
    return true;
}

// xorshift64*: random numbers for the walks, from the seed
fn rand(mut x: &i64) -> i64 {
    var v: i64 = *x;
    v = v ^ ((v >> 12) & 0xFFFFFFFFFFFFF);
    v = v ^ (v << 25);
    v = v ^ ((v >> 27) & 0x1FFFFFFFFF);
    *x = v;
    return (v *% 0x2545F4914F6CDD1D) & 0x7FFFFFFFFFFFFFFF;
}

// The trace of a walk: its states and how each was reached.
fn walk_trace(states: &i64[], labels: &string[], mut r: &Report) -> void {
    say(r, "Error: The behavior up to this point is:");
    for (let i: i64 in 0..states.len) {
        var label: string = labels[i];
        if (label.len == 0) { label = "Next"; }
        say(r, "State \(i + 1): <\(label)>");
        for (let l: string in show_state(states[i])) { say(r, l); }
        say(r, "");
    }
}

// Simulation (TLC's -simulate): o.simulate random behaviors from the initial states, each at
// most o.depth steps (fewer if stopped: no successor, or outside a CONSTRAINT), checking every
// state against the invariants. Finds deep bugs in models too large to search but proves
// nothing: only a search passes a model.
fn simulate(
    o: &Options, init: i64, act: i64, invs: &i64[], inv_names: &string[], cons: &i64[],
    deadlock: bool, mut r: &Report
) -> void | EvalError {
    var x: i64 = o.seed *% 0x9E3779B97F4A7C15;
    if (x == 0) { x = 1; }
    reset_envs();
    initial(init)?;
    let firsts: i64[] = std::copy(cx.found);
    if (firsts.len == 0) {
        say(r, "Error: Init has no states");
        r.code = 75;
        return;
    }
    var steps: i64 = 0;
    var keep: i64[] = std::copy(firsts);
    for (let b: i64 in 0..o.simulate) {
        // Every 1000 behaviors, free the last ones' values (value::compact), keeping only the
        // initial states and the evaluator's values.
        if (b % 1000 == 999) {
            var roots: i64[] = std::copy(keep);
            value_roots(mut &roots);
            compact(mut &roots);
            for (let i: i64 in 0..keep.len) { keep[i] = roots[i]; }
            reroot(&roots, keep.len);
        }
        var states: i64[] = [];
        var labels: string[] = [];
        var st: i64 = keep[rand(mut &x) % keep.len];
        states.push(st);
        labels.push("Initial predicate");
        while (true) {
            steps += 1;
            for (let i: i64 in 0..invs.len) {
                if (!holds(st, invs[i])?) {
                    say(r, "Error: Invariant \(inv_names[i]) is violated (behavior \(b + 1) of seed \(o.seed)).");
                    walk_trace(&states, &labels, r);
                    r.code = 12;
                    r.generated = steps;
                    return;
                }
            }
            if (states.len > o.depth) { break; }
            var inside: bool = true;
            for (let p: i64 in cons) { if (!holds(st, p)?) { inside = false; } }
            if (!inside) { break; }
            successors(st, act)?;
            let n: i64 = cx.found.len;
            if (n == 0) {
                if (deadlock) {
                    say(r, "Error: Deadlock reached (behavior \(b + 1) of seed \(o.seed)).");
                    walk_trace(&states, &labels, r);
                    r.code = 11;
                    return;
                }
                break;
            }
            let k: i64 = rand(mut &x) % n;
            st = cx.found[k];
            states.push(st);
            labels.push(std::copy(cx.labels[k]));
        }
        if (o.progress && (b + 1) % 1000 == 0) { eprintln("progress: \(b + 1) behaviors, \(steps) states"); }
    }
    r.generated = steps;
    say(r, "Simulation finished: \(o.simulate) behaviors of at most \(o.depth) steps, \(steps) states checked, seed \(o.seed). No error has been found (which proves nothing: only a search does).");
}

/// Checks the spec in o.spec against its cfg.
export fn check(o: &Options) -> Report {
    var r: Report = Report {};
    let src: string = fs::read_file(o.spec) ?? "\u{0}";
    if (str::eq(src, "\u{0}")) {
        say(mut &r, "Error: cannot read \(o.spec)");
        r.code = 150;
        return r;
    }
    match (parse(src, o.spec)) {
        v => {},
        e: ParseError => {
            say(mut &r, "Error: \(e.msg)");
            r.code = 150;
            return r;
        },
    }
    var cfg_path: string = o.cfg;
    if (cfg_path.len == 0) {
        cfg_path = o.spec;
        if (cfg_path.len > 4 && str::eq(cfg_path[cfg_path.len - 4..], ".tla")) {
            cfg_path = cfg_path[0..cfg_path.len - 4];
        }
        cfg_path = "\(cfg_path).cfg";
    }
    let csrc: string = fs::read_file(cfg_path) ?? "\u{0}";
    if (str::eq(csrc, "\u{0}")) {
        say(mut &r, "Error: cannot read \(cfg_path)");
        r.code = 150;
        return r;
    }
    var c: Cfg = Cfg {};
    match (read_cfg(csrc, cfg_path)) {
        v => { c = v; },
        e: CfgError => {
            say(mut &r, "Error: \(e.msg)");
            r.code = 150;
            return r;
        },
    }
}

fn run(o: &Options, c: &Cfg, mut r: &Report) -> void | EvalError {
    reset();
    // The constants: values first, then those given by definitions (which may use them).
    let nc: i64 = prog.consts.len;
    var consts: i64[nc];
    var given: bool[nc];
    for (let i: i64 in 0..c.names.len) {
        let s: i64 = sym(c.names[i]);
        let g: Global = glob(s);
        if (g.kind != Kind::Const) {
            say(r, "Error: \(c.names[i]) in the cfg is not a CONSTANT of the spec");
            r.code = 150;
            return;
        }
        if (!str::eq(c.vals[i].kind, "def")) {
            consts[g.index] = cval(&c.vals[i])?;
            given[g.index] = true;
        }
    }
    start(std::copy(consts));
    for (let i: i64 in 0..c.names.len) {
        if (str::eq(c.vals[i].kind, "def")) {
            let s: i64 = sym(c.names[i]);
            let g: Global = glob(s);
            let d: i64 = named(c.vals[i].text, "definition", r);
            if (d < 0) { return; }
            if (!constant_node(d)) {
                say(r, "Error: \(c.vals[i].text), given to \(c.names[i]), depends on the variables");
                r.code = 150;
                return;
            }
            consts[g.index] = eval(d, -1)?;
            given[g.index] = true;
            cx.consts = std::copy(consts);
        }
    }
    for (let i: i64 in 0..nc) {
        if (!given[i]) {
            say(r, "Error: the constant \(name(prog.consts[i])) has no value in the cfg");
            r.code = 150;
            return;
        }
    }
    for (let a: i64 in &prog.assumes) {
        if (!constant_node(a)) {
            say(r, "Error: \(pos(a)): an ASSUME uses a variable");
            r.code = 150;
            return;
        }
        reset_envs();
        if (eval(a, -1)? != TRUE) {
            say(r, "Error: Assumption at \(pos(a)) is false.");
            r.code = 10;
            return;
        }
    }
    var init: i64 = -1;
    var act: i64 = -1;
    var fair: i64[] = [];
    if (c.spec.len > 0) {
        from_spec(c.spec, r, mut &init, mut &act, mut &fair);
    } else {
        init = named(c.init, "INIT", r);
        act = named(c.act, "NEXT", r);
    }
    if (r.code != 0) { return; }
    var invs: i64[] = [];
    for (let n: string in &c.invariants) { invs.push(named(n, "INVARIANT", r)); }
    var cons: i64[] = [];
    for (let n: string in &c.constraints) { cons.push(named(n, "CONSTRAINT", r)); }
    if (r.code != 0) { return; }
    let deadlock: bool = c.deadlock && o.deadlock;

    var s: Search = Search {};
    if (c.symmetry.len > 0) {
        let d: i64 = named(c.symmetry, "SYMMETRY", r);
        if (d < 0) { return; }
        reset_envs();
        for (let f: i64 in elements(eval(d, -1)?)?) {
            if (!is_tag(f, Tag::Func)) {
                say(r, "Error: SYMMETRY \(c.symmetry) holds \(show(f)), which is not a permutation");
                r.code = 150;
                return;
            }
            var perm: Map(i64, i64) = Map {};
            let dom: i64[] = xs(f);
            let rng: i64[] = ys(f);
            for (let i: i64 in 0..dom.len) {
                if (!is_tag(dom[i], Tag::Model) || !is_tag(rng[i], Tag::Model)) {
                    say(r, "Error: SYMMETRY \(c.symmetry) renames \(show(dom[i])): only model values may be renamed");
                    r.code = 150;
                    return;
                }
                perm.put(dom[i], rng[i]);
            }
            s.perms.push(perm);
            s.caches.push(Map {});
        }
        s.sym = true;
    }
    if (s.perms.len == 0) {
        // (without SYMMETRY: a state's own fingerprint)
        s.perms.push(Map {});
        s.caches.push(Map {});
    }
    s.init = init;
    s.act = act;
    if (c.properties.len > 0) {
        if (s.sym) {
            say(r, "Error: PROPERTY with SYMMETRY: states equal up to renaming fall together, which fairness for each of them (\\A r : WF(A(r))) can't be checked on. Leave SYMMETRY out of a cfg with a PROPERTY");
            r.code = 150;
            return;
        }
        if (o.simulate > 0) {
            say(r, "Error: PROPERTY is checked by a search of every state, not by -simulate");
            r.code = 150;
            return;
        }
        for (let n: string in &c.properties) {
            let d: i64 = named(n, "PROPERTY", r);
            if (d < 0) { return; }
            let body: i64 = glob(sym(n)).body;
            let nd: Node = std::copy(prog.nodes[body]);
            if (nd.op == Op::LeadsTo) {
                s.props.push(Prop { name: n, p: nd.a, q: nd.b });
            } else if (nd.op == Op::Box && prog.nodes[nd.a].op == Op::Diamond) {
                s.props.push(Prop { name: n, p: -1, q: prog.nodes[nd.a].a });
            } else if (nd.op == Op::Diamond) {
                s.props.push(Prop { name: n, p: -2, q: nd.a });
            } else {
                say(r, "Error: the PROPERTY \(n) must be P ~> Q, []<>Q or <>Q, with P and Q state predicates");
                r.code = 150;
                return;
            }
            let pr: Prop = std::copy(s.props[s.props.len - 1]);
            var seen: Map(i64, i64) = Map {};
            if (!state_predicate(pr.q, mut &seen) || (pr.p >= 0 && !state_predicate(pr.p, mut &seen))) {
                say(r, "Error: the PROPERTY \(n) must be P ~> Q, []<>Q or <>Q, with P and Q state predicates (no primes, UNCHANGED or temporal operators)");
                r.code = 150;
                return;
            }
        }
        if (s.props.len > 31) {
            say(r, "Error: at most 31 PROPERTY a cfg");
            r.code = 150;
            return;
        }
        reset_envs();
        let unbound: i64[] = [];
        for (let f: i64 in &fair) { expand_fairness(f, &unbound, &unbound, mut &s.fairs)?; }
        if (s.fairs.len > 63) {
            say(r, "Error: \(s.fairs.len) fairness conditions (every \\A's instance counts): at most 63");
            r.code = 150;
            return;
        }
        s.live = true;
    }
    s.compact_at = o.compact_at;
    s.compact_min = o.compact_at;
    if (o.simulate > 0) {
        simulate(o, init, act, &invs, &c.invariants, &cons, deadlock, r)?;
        return;
    }
    reset_envs();
    initial(init)?;
    let firsts: i64[] = std::copy(cx.found);
    for (let st: i64 in &firsts) {
        if (!found(mut &s, st, -1, "Initial predicate", &invs, &c.invariants, r)?) {
            counts(&s, r);
            return;
        }
    }
    var head: i64 = 0;
    while (head < s.states.len) {
        if (vt.nodes.len > s.compact_at) { let_go(mut &s, head); }
        let k: i64 = head;
        head += 1;
        let st: i64 = s.states[k];
        s.states[k] = -1;                   // (st's values stay until the next let_go)
        var inside: bool = true;
        for (let p: i64 in &cons) {
            if (!holds(st, p)?) {
                inside = false;
                break;
            }
        }
        if (!inside) {
            if (s.live) {
                s.succ.push([]);
                s.steps.push([]);
                s.enabled.push(0);
                s.pq.push(0);
                s.out.push(true);
            }
            continue;
        }
        match (successors(st, act)) {
            v => {},
            e: EvalError => {
                say(r, "Error: \(where_at()): \(e.msg)");
                say(r, "Error: while finding the successors of the last state of:");
                trace(mut &s, k, r);
                r.code = 75;
                counts(&s, r);
                return;
            },
        }
        let next_states: i64[] = std::copy(cx.found);
        let labels: string[] = std::copy(cx.labels);
        if (next_states.len == 0 && deadlock) {
            say(r, "Error: Deadlock reached.");
        }
    }
}

// The examples in examples/, with TLC's counts (a separate brute-force count agrees):
// distinct states, states generated, depth. aec test runs from tla's root.
fn expect(spec: string, cfg: string, code: i64, distinct: i64, generated: i64, depth: i64) -> i32 {
    let r: Report = check(&Options { spec: "examples/\(spec).tla", cfg: cfg });
    if (r.code != code || r.distinct != distinct || r.generated != generated || r.depth != depth) {
        for (let l: string in &r.out) { eprintln(l); }
        eprintln("\(spec): code \(r.code), \(r.distinct) distinct, \(r.generated) generated, depth \(r.depth)");
        return 1;
    }
    return 0;
}

#test fn the_examples_have_tlcs_counts() -> i32 {
    if (expect("TCommit", "", 0, 34, 94, 7) != 0) { return 1; }
    if (expect("TwoPhase", "", 0, 288, 1146, 11) != 0) { return 2; }
    // same, with interchangeable resource managers: 80 classes of the 288 (counted separately)
    if (expect("TwoPhaseSym", "", 0, 80, 318, 11) != 0) { return 5; }
    // DieHard's NotSolved fails after the 6 pours of the film (7 states).
    if (expect("DieHard", "", 12, 14, 73, 7) != 0) { return 3; }
    let r: Report = check(&Options { spec: "examples/DieHard.tla" });
    var states: i64 = 0;
    for (let l: string in &r.out) { if (l.len > 6 && str::eq(l[0..6], "State ")) { states += 1; } }
    if (states != 7) { return 4; }
    return 0;
}

// The same searches, freeing explored states' values every step: counts and trace must not
// change (fingerprints don't depend on ids, and the trace is rebuilt).
#test fn letting_go_of_explored_states_changes_nothing() -> i32 {
    let names: string[] = ["TCommit", "TwoPhase", "TwoPhaseSym", "DieHard"];
    for (let i: i64 in 0..names.len) {
        let spec: string = "examples/\(names[i]).tla";
        let a: Report = check(&Options { spec: spec });
        let b: Report = check(&Options { spec: spec, compact_at: 1 });
        if (a.code != b.code || a.distinct != b.distinct || a.generated != b.generated || a.depth != b.depth) {
            eprintln("\(names[i]): \(a.code) \(a.distinct) \(a.generated) \(a.depth), compacting: \(b.code) \(b.distinct) \(b.generated) \(b.depth)");
            return (i + 1) as i32;
        }
        if (a.out.len != b.out.len) { return (10 + i) as i32; }
        for (let j: i64 in 0..a.out.len) { if (!str::eq(a.out[j], b.out[j])) { return (20 + i) as i32; } }
    }
    return 0;
}

#test fn the_semantics_hold() -> i32 {
    // Each ASSUME in Semantics.tla is a TLA+ fact; a false one would give code 10.
    return expect("Semantics", "", 0, 1, 2, 1);
}

// Checks module body (named m) with cfg in a temp directory; returns the exit code.
fn code_of(m: string, body: string, cfg: string) -> i64 {
    let dir: string = fs::temp_dir();
    let spec: string = "\(dir)/\(m).tla";
    fs::write_file(spec, "---- MODULE \(m) ----\n\(body)\n====\n");
    fs::write_file("\(dir)/\(m).cfg", cfg);
    let r: Report = check(&Options { spec: spec });
    return r.code;
}

// Liveness, answers known by hand: fairness keeps a behavior going; WF lets an action enabled
// only intermittently wait forever, SF doesn't; \A's fairness applies to each instance.
#test fn liveness_under_fairness() -> i32 {
    let counter: string = "EXTENDS Naturals\nVARIABLE x\nvars == <<x>>\nInit == x = 0\nNext == x' = (x + 1) % 3\nTwo == x = 2\nOften == []<>Two\nSoon == <>Two\nLeads == (x = 0) ~> (x = 2)\n";
    if (code_of("L1", "\(counter)Spec == Init /\\ [][Next]_vars /\\ WF_vars(Next)", "SPECIFICATION Spec\nPROPERTY Often Soon Leads\n") != 0) { return 1; }
    if (code_of("L2", "\(counter)Spec == Init /\\ [][Next]_vars", "SPECIFICATION Spec\nPROPERTY Soon\n") != 13) { return 2; }
    // Go is enabled only while y = 1, and Tick keeps turning y over.
    let toggle: string = "VARIABLES x, y\nvars == <<x, y>>\nInit == x = 0 /\\ y = 0\nTick == y' = 1 - y /\\ x' = x\nGo == y = 1 /\\ x = 0 /\\ x' = 1 /\\ y' = y\nNext == Tick \\/ Go\nGone == <>(x = 1)\n";
    if (code_of("L3", "EXTENDS Naturals\n\(toggle)Spec == Init /\\ [][Next]_vars /\\ WF_vars(Tick) /\\ WF_vars(Go)", "SPECIFICATION Spec\nPROPERTY Gone\n") != 13) { return 3; }
    if (code_of("L4", "EXTENDS Naturals\n\(toggle)Spec == Init /\\ [][Next]_vars /\\ WF_vars(Tick) /\\ SF_vars(Go)", "SPECIFICATION Spec\nPROPERTY Gone\n") != 0) { return 4; }
    // Each process steps once; fairness for each, or for one.
    let procs: string = "CONSTANT P\nVARIABLE done\nvars == <<done>>\nInit == done = [p \\in P |-> FALSE]\nStep(p) == ~done[p] /\\ done' = [done EXCEPT ![p] = TRUE]\nNext == \\E p \\in P : Step(p)\nAll == <>(\\A p \\in P : done[p])\n";
    let pcfg: string = "CONSTANTS\n  P = {a, b}\nSPECIFICATION Spec\nPROPERTY All\nCHECK_DEADLOCK FALSE\n";
    if (code_of("L5", "\(procs)Spec == Init /\\ [][Next]_vars /\\ \\A p \\in P : WF_vars(Step(p))", pcfg) != 0) { return 5; }
    if (code_of("L6", "\(procs)Spec == Init /\\ [][Next]_vars /\\ WF_vars(Step(CHOOSE p \\in P : TRUE))", pcfg) != 13) { return 6; }
    // Refused, not passed: PROPERTY with SYMMETRY, and a property of another form.
    if (code_of("L7", "EXTENDS TLC\n\(procs)Perms == Permutations(P)\nSpec == Init /\\ [][Next]_vars", "\(pcfg)SYMMETRY Perms\n") != 150) { return 7; }
    if (code_of("L8", "\(counter)Box == [](x < 3)\nSpec == Init /\\ [][Next]_vars", "SPECIFICATION Spec\nPROPERTY Box\n") != 150) { return 8; }
    return 0;
}
