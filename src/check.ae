// tla's model checker: a breadth-first search of every state a spec can reach, as TLC does,
// checking each against the invariants.
//
// * As in TLC, a found state is kept as its fingerprint, parent and how it was reached; it is
//   kept whole (an interned tuple, value.ae) only while queued. Values held only by explored
//   states are freed now and then (value::compact). A violation is shown as the shortest
//   behavior leading to it, in TLC's wording and layout: the behavior is found again from the
//   initial states, each step the successor with the next fingerprint.
// * A state breaking a CONSTRAINT is checked against the invariants, but its successors are not
//   explored. (So a constraint bounds the search and can hide only states, never steps.)
// * Deadlock (a state with no successor) is an error unless CHECK_DEADLOCK FALSE, as in TLC.
// * PROPERTY: P ~> Q, []<>Q (TRUE ~> Q) or <>Q (Q eventually, from the initial states), P and Q
//   state predicates, under the SPECIFICATION's fairness (WF_vars(A), SF_vars(A), also under
//   \A). Checked as TLC does: the state graph is kept (each state's successors, which fairness
//   conditions each step is a step of, which are enabled where); the states still awaiting Q
//   (reached from one where P holds and Q doesn't, through states where Q doesn't) are split
//   into strongly connected components, each state able to stutter; a component a fair
//   behavior can stay in forever is a counterexample, shown as a behavior into it and around
//   it. WF holds in a component if its action is taken in it or disabled in one of its states;
//   SF, if taken or disabled in all of them (else the states where it's enabled are dropped
//   and the rest split again).
// * Exit codes are TLC's: 0 no error, 10 an ASSUME is false, 11 deadlock, 12 an invariant is
//   violated, 13 a temporal property is violated, 75 an evaluation error, 150 a spec or cfg
//   could not be read. tla adds 1: the search stopped at a limit (max_states, max_values)
//   before finishing, so a model too large for the machine stops with a message instead of
//   being killed.

import fs from "std/fs";
import { Map } from "std/containers";
import { Op, Node, Kind, Global, prog, sym, name, add, pos, glob } from "ast.ae";
import { parse, ParseError } from "parse.ae";
import { Cfg, CVal, CfgError, read_cfg } from "cfg.ae";
import { EvalError, reset, mk_int, mk_str, mk_model, mk_bool, mk_set, show, xs, ys, TRUE, vt, Tag, is_tag, elements, fingerprint, compact } from "value.ae";
import { cx, start, eval, initial, successors, successors_with, eval_with, holds, constant_node, reset_envs, where_at, value_roots, reroot } from "eval.ae";
import str from "std/string";
import process from "std/process";

/// What a check found.
export struct Report {
    export code: i64 = 0;
    export distinct: i64 = 0;           // Distinct states found.
    export generated: i64 = 0;          // States generated, including repeats.
    export depth: i64 = 0;              // Longest shortest path from an initial state, + 1.
    export out: string[] = [];          // Output: verdict, trace, counts.
}

/// How to check.
export struct Options {
    export spec: string;                // The .tla file.
    export cfg: string = "";            // The .cfg file; if "", the spec's name with .cfg.
    export deadlock: bool = true;       // false: never report deadlock (TLC's -deadlock).
    export progress: bool = false;      // Print progress while searching.
    export max_states: i64 = 1000000;   // Stop past this many distinct states,
    export max_values: i64 = 20000000;  // or this many values made (each ~100 bytes or more).
    export compact_at: i64 = 1000000;   // Free explored states' values at this many, then
                                        //   at twice as many as were kept (tests: 1, every step).
    export simulate: i64 = 0;           // > 0: that many random behaviors instead of a search,
    export depth: i64 = 100;            //   each at most this many steps,
    export seed: i64 = 1;               //   from this seed (same seed, same walks).
}

struct Search {
    states: i64[] = [];                 // In order found: the queue. (Not renamed, so each is a
                                        //   successor of its parent and a trace is a behavior,
                                        //   with or without SYMMETRY.) -1 once explored.
    fps: i64[] = [];                    // Each state's canonical form.
    parents: i64[] = [];
    depths: i64[] = [];
    seen: Map(i64, i64) = Map {};       // Each state's canonical form -> its index.
    perms: Map(i64, i64)[] = [];        // SYMMETRY's permutations (model value -> model value)
    caches: Map(i64, i64)[] = [];       //   and the fingerprints each made. Without SYMMETRY,
    sym: bool = false;                  //   just the identity.
    init: i64 = -1;                     // Init and Next, to rebuild a trace's behavior.
    act: i64 = -1;
    compact_at: i64 = 1000000;          // Free explored states' values past this many,
    compact_min: i64 = 1000000;         //   and at least this many (Options.compact_at).
    // The state graph for PROPERTY (live), by state, in explored order.
    live: bool = false;
    fairs: Fairness[] = [];
    props: Prop[] = [];
    succ: i64[][] = [];                 // Its successors (indices).
    steps: i64[][] = [];                // Per successor: fairness conditions it's a step of (bits).
    enabled: i64[] = [];                // The fairness conditions enabled in it (bits).
    pq: i64[] = [];                     // Bit 2i: props[i].p holds in it; bit 2i + 1: props[i].q.
    out: bool[] = [];                   // Outside the CONSTRAINT: not explored.
}

// st's canonical form: its least fingerprint under SYMMETRY's permutations (without SYMMETRY,
// its fingerprint), as in TLC: two states merge only if equal up to renaming or their
// fingerprints collide (the report gives the odds).
fn canonical(mut s: &Search, st: i64) -> i64 {
    var best: i64 = 9223372036854775807;
    for (let i: i64 in 0..s.perms.len) {
        let h: i64 = fingerprint(st, &s.perms[i], mut &s.caches[i]);
        if (h < best) { best = h; }
    }
    // caches only speed things up: empty them before they grow too large
    if (s.caches[0].len() > 4000000) {
        for (let i: i64 in 0..s.caches.len) { s.caches[i] = Map {}; }
    }
    return best;
}

fn say(mut r: &Report, line: string) -> void { r.out.push(line); }

fn show_state(st: i64) -> string[] {
    var lines: string[] = [];
    let vals: i64[] = ys(st);
    for (let i: i64 in 0..vals.len) { lines.push("/\\ \(name(prog.vars[i])) = \(show(vals[i]))"); }
    return lines;
}

// The behavior ending at state last, rebuilt (explored states aren't kept whole): from the
// initial states, each step the successor whose canonical form is the next state's. Its
// states go in states, how each was reached in labels.
fn replay(mut s: &Search, last: i64, mut states: &i64[], mut labels: &string[]) -> void | EvalError {
    var path: i64[] = [];
    var k: i64 = last;
    while (k >= 0) {
        path.push(k);
        k = s.parents[k];
    }
    reset_envs();
    initial(s.init)?;
    var choices: i64[] = std::copy(cx.found);
    var how: string[] = [];
    for (let c: i64 in &choices) { how.push("Initial predicate"); }
    var i: i64 = path.len - 1;
    while (i >= 0) {
        let want: i64 = s.fps[path[i]];
        var got: i64 = -1;
        for (let j: i64 in 0..choices.len) {
            if (canonical(s, choices[j]) == want) {
                got = j;
                break;
            }
        }
        if (got < 0) { fail EvalError { msg: "no successor has the next state's fingerprint" }; }
        states.push(choices[got]);
        labels.push(std::copy(how[got]));
        i -= 1;
        if (i >= 0) {
            successors(choices[got], s.act)?;
            choices = std::copy(cx.found);
            how = std::copy(cx.labels);
        }
    }
}

fn trace(mut s: &Search, last: i64, mut r: &Report) -> void {
    var states: i64[] = [];
    var labels: string[] = [];
    match (replay(s, last, mut &states, mut &labels)) {
        v => {},
        e: EvalError => {
            say(r, "Error: the behavior could not be found again: \(e.msg)");
            return;
        },
    }
    say(r, "Error: The behavior up to this point is:");
    for (let i: i64 in 0..states.len) {
        var label: string = labels[i];
        if (label.len == 0) { label = "Next"; }
        say(r, "State \(i + 1): <\(label)>");
        for (let l: string in show_state(states[i])) { say(r, l); }
        say(r, "");
    }
}

fn counts(s: &Search, mut r: &Report) -> void {
    r.distinct = s.states.len;
    var d: i64 = 0;
    for (let x: i64 in &s.depths) { if (x > d) { d = x; } }
    r.depth = d;
    say(r, "\(r.generated) states generated, \(r.distinct) distinct states found.");
    // TLC's optimistic estimate: n * m / 2^64, for n distinct of m generated
    let p: f64 = (r.distinct as f64) * (r.generated as f64) / 18446744073709551616.0;
    var how: string = "";
    if (s.sym) { how = ", up to SYMMETRY's renamings"; }
    say(r, "States are told apart by 64-bit fingerprints\(how): the chance of a collision is about \(p).");
    say(r, "The depth of the complete state graph search is \(r.depth).");
}

// Adds st (found from parent by label) if new, then checks the invariants. Returns false if
// one fails (r says which).
fn found(mut s: &Search, st: i64, parent: i64, label: string, invs: &i64[], inv_names: &string[], mut r: &Report) -> bool | EvalError {
    r.generated += 1;
    let c: i64 = canonical(s, st);
    if (s.seen.has(c)) { return true; }
    let k: i64 = s.states.len;
    s.seen.put(c, k);
    s.states.push(st);
    s.fps.push(c);
    s.parents.push(parent);
    var d: i64 = 1;
    if (parent >= 0) { d = s.depths[parent] + 1; }
    s.depths.push(d);
    for (let i: i64 in 0..invs.len) {
        if (!holds(st, invs[i])?) {
            say(r, "Error: Invariant \(inv_names[i]) is violated.");
            trace(s, k, r);
            r.code = 12;
            return false;
        }
    }
    return true;
}

/// Checks the spec in o.spec against its cfg.
export fn check(o: &Options) -> Report {
    var r: Report = Report {};
    let src: string = fs::read_file(o.spec) ?? "\u{0}";
    if (str::eq(src, "\u{0}")) {
        say(mut &r, "Error: cannot read \(o.spec)");
        r.code = 150;
        return r;
    }
    match (parse(src, o.spec)) {
        v => {},
        e: ParseError => {
            say(mut &r, "Error: \(e.msg)");
            r.code = 150;
            return r;
        },
    }
    var cfg_path: string = o.cfg;
    if (cfg_path.len == 0) {
        cfg_path = o.spec;
        if (cfg_path.len > 4 && str::eq(cfg_path[cfg_path.len - 4..], ".tla")) {
            cfg_path = cfg_path[0..cfg_path.len - 4];
        }
        cfg_path = "\(cfg_path).cfg";
    }
    let csrc: string = fs::read_file(cfg_path) ?? "\u{0}";
    if (str::eq(csrc, "\u{0}")) {
        say(mut &r, "Error: cannot read \(cfg_path)");
        r.code = 150;
        return r;
    }
}

fn run(o: &Options, c: &Cfg, mut r: &Report) -> void | EvalError {
    reset();
    // The constants: values first, then those given by definitions (which may use them).
    let nc: i64 = prog.consts.len;
    var consts: i64[nc];
    var given: bool[nc];
    for (let i: i64 in 0..c.names.len) {
        let s: i64 = sym(c.names[i]);
        let g: Global = glob(s);
        if (g.kind != Kind::Const) {
            say(r, "Error: \(c.names[i]) in the cfg is not a CONSTANT of the spec");
            r.code = 150;
            return;
        }
        if (!str::eq(c.vals[i].kind, "def")) {
            consts[g.index] = cval(&c.vals[i])?;
            given[g.index] = true;
        }
    }
    start(std::copy(consts));
    for (let i: i64 in 0..c.names.len) {
        if (str::eq(c.vals[i].kind, "def")) {
            let s: i64 = sym(c.names[i]);
            let g: Global = glob(s);
            let d: i64 = named(c.vals[i].text, "definition", r);
            if (d < 0) { return; }
            if (!constant_node(d)) {
                say(r, "Error: \(c.vals[i].text), given to \(c.names[i]), depends on the variables");
                r.code = 150;
                return;
            }
            consts[g.index] = eval(d, -1)?;
            given[g.index] = true;
            cx.consts = std::copy(consts);
        }
    }
    for (let i: i64 in 0..nc) {
        if (!given[i]) {
            say(r, "Error: the constant \(name(prog.consts[i])) has no value in the cfg");
            r.code = 150;
            return;
        }
    }
    for (let a: i64 in &prog.assumes) {
        if (!constant_node(a)) {
            say(r, "Error: \(pos(a)): an ASSUME uses a variable");
            r.code = 150;
            return;
        }
        reset_envs();
        if (eval(a, -1)? != TRUE) {
            say(r, "Error: Assumption at \(pos(a)) is false.");
            r.code = 10;
            return;
        }
    }
    var init: i64 = -1;
    var act: i64 = -1;
    var fair: i64[] = [];
    if (c.spec.len > 0) {
        from_spec(c.spec, r, mut &init, mut &act, mut &fair);
    } else {
        init = named(c.init, "INIT", r);
        act = named(c.act, "NEXT", r);
    }
    if (r.code != 0) { return; }
    var invs: i64[] = [];
    for (let n: string in &c.invariants) { invs.push(named(n, "INVARIANT", r)); }
    var cons: i64[] = [];
    for (let n: string in &c.constraints) { cons.push(named(n, "CONSTRAINT", r)); }
    if (r.code != 0) { return; }
    let deadlock: bool = c.deadlock && o.deadlock;

    var s: Search = Search {};
    if (c.symmetry.len > 0) {
        let d: i64 = named(c.symmetry, "SYMMETRY", r);
        if (d < 0) { return; }
        reset_envs();
        for (let f: i64 in elements(eval(d, -1)?)?) {
            if (!is_tag(f, Tag::Func)) {
                say(r, "Error: SYMMETRY \(c.symmetry) holds \(show(f)), which is not a permutation");
                r.code = 150;
                return;
            }
            var perm: Map(i64, i64) = Map {};
            let dom: i64[] = xs(f);
            let rng: i64[] = ys(f);
            for (let i: i64 in 0..dom.len) {
                if (!is_tag(dom[i], Tag::Model) || !is_tag(rng[i], Tag::Model)) {
                    say(r, "Error: SYMMETRY \(c.symmetry) renames \(show(dom[i])): only model values may be renamed");
                    r.code = 150;
                    return;
                }
                perm.put(dom[i], rng[i]);
            }
            s.perms.push(perm);
            s.caches.push(Map {});
        }
        s.sym = true;
    }
    if (s.perms.len == 0) {
        // (without SYMMETRY: a state's own fingerprint)
        s.perms.push(Map {});
        s.caches.push(Map {});
    }
    s.init = init;
    s.act = act;
    if (c.properties.len > 0) {
        if (s.sym) {
            say(r, "Error: PROPERTY with SYMMETRY: states equal up to renaming fall together, which fairness for each of them (\\A r : WF(A(r))) can't be checked on. Leave SYMMETRY out of a cfg with a PROPERTY");
            r.code = 150;
            return;
        }
        if (o.simulate > 0) {
            say(r, "Error: PROPERTY is checked by a search of every state, not by -simulate");
            r.code = 150;
            return;
        }
        for (let n: string in &c.properties) {
            let d: i64 = named(n, "PROPERTY", r);
            if (d < 0) { return; }
            let body: i64 = glob(sym(n)).body;
            let nd: Node = std::copy(prog.nodes[body]);
            if (nd.op == Op::LeadsTo) {
                s.props.push(Prop { name: n, p: nd.a, q: nd.b });
            } else if (nd.op == Op::Box && prog.nodes[nd.a].op == Op::Diamond) {
                s.props.push(Prop { name: n, p: -1, q: prog.nodes[nd.a].a });
            } else if (nd.op == Op::Diamond) {
                s.props.push(Prop { name: n, p: -2, q: nd.a });
            } else {
                say(r, "Error: the PROPERTY \(n) must be P ~> Q, []<>Q or <>Q, with P and Q state predicates");
                r.code = 150;
                return;
            }
            let pr: Prop = std::copy(s.props[s.props.len - 1]);
            var seen: Map(i64, i64) = Map {};
        }
    }
}

// The examples in examples/, with TLC's counts (a separate brute-force count agrees):
// distinct states, states generated, depth. aec test runs from tla's root.
fn expect(spec: string, cfg: string, code: i64, distinct: i64, generated: i64, depth: i64) -> i32 {
    let r: Report = check(&Options { spec: "examples/\(spec).tla", cfg: cfg });
    if (r.code != code || r.distinct != distinct || r.generated != generated || r.depth != depth) {
        for (let l: string in &r.out) { eprintln(l); }
        eprintln("\(spec): code \(r.code), \(r.distinct) distinct, \(r.generated) generated, depth \(r.depth)");
        return 1;
    }
    return 0;
}

#test fn the_examples_have_tlcs_counts() -> i32 {
    if (expect("TCommit", "", 0, 34, 94, 7) != 0) { return 1; }
    if (expect("TwoPhase", "", 0, 288, 1146, 11) != 0) { return 2; }
    // same, with interchangeable resource managers: 80 classes of the 288 (counted separately)
    if (expect("TwoPhaseSym", "", 0, 80, 318, 11) != 0) { return 5; }
    // DieHard's NotSolved fails after the 6 pours of the film (7 states).
    if (expect("DieHard", "", 12, 14, 73, 7) != 0) { return 3; }
    let r: Report = check(&Options { spec: "examples/DieHard.tla" });
    var states: i64 = 0;
    for (let l: string in &r.out) { if (l.len > 6 && str::eq(l[0..6], "State ")) { states += 1; } }
    if (states != 7) { return 4; }
    return 0;
}

#test fn the_semantics_hold() -> i32 {
    // Each ASSUME in Semantics.tla is a TLA+ fact; a false one would give code 10.
    return expect("Semantics", "", 0, 1, 2, 1);
}

// Checks module body (named m) with cfg in a temp directory; returns the exit code.
fn code_of(m: string, body: string, cfg: string) -> i64 {
    let dir: string = fs::temp_dir();
    let spec: string = "\(dir)/\(m).tla";
    fs::write_file(spec, "---- MODULE \(m) ----\n\(body)\n====\n");
    fs::write_file("\(dir)/\(m).cfg", cfg);
    let r: Report = check(&Options { spec: spec });
    return r.code;
}
