// Parser for tla's subset of TLA+ (README.md). Fills `prog` (ast.ae) from a module's text,
// resolving names as read, as SANY does: a name is used only after its definition, and a bound
// name may not reuse one in scope. So any spec this parser accepts, SANY accepts too, and TLC
// could check it.
//
// * Precedence follows TLA+'s table (Specifying Systems, 15.2.1), each range cut to one level.
//   Where TLA+ calls two operators a conflict, so does this parser: /\ and \/ mixed without
//   parentheses or bullets, and relation chains (a = b = c).
// * A bullet list (a column of /\ or \/) fences its column: any token at or left of it ends the
//   current item, as in SANY. Parentheses do not lift the fence.
// * What the subset omits is an explicit error, never a silent skip: temporal formulas outside
//   a SPECIFICATION, ENABLED, INSTANCE, LAMBDA, operators as arguments, user-defined infix
//   operators, unbounded quantifiers and CHOOSE, recursive functions, and tuple binders.

import fs from "std/fs";
import { Tk, Token, Lexed, lex } from "lex.ae";
import { Op, Node, Kind, Global, Prog, prog, sym, name, add, glob } from "ast.ae";
import str from "std/string";

// A name bound in an expression: a quantifier variable, a parameter, or a LET definition
// (arity: -1 for a bound value, n >= 0 for a LET definition with n parameters).
struct Bound {
    sym: i64;
    arity: i64;
}

struct Parser {
    toks: Token[] = [];
    i: i64 = 0;
    fences: i64[] = [];                 // Columns of the bullet lists being read.
    bound: Bound[] = [];
    file: string = "";
    dir: string = "";
    excepts: i64 = 0;                   // EXCEPT values being read (where @ may appear).
    spec_ok: bool = false;              // Temporal operators allowed (a SPECIFICATION).
}

let keywords: string[] = [
    "MODULE", "EXTENDS", "CONSTANT", "CONSTANTS", "VARIABLE", "VARIABLES", "ASSUME", "ASSUMPTION",
    "AXIOM", "THEOREM", "LEMMA", "LOCAL", "RECURSIVE", "INSTANCE", "WITH", "IF", "THEN", "ELSE",
    "CASE", "OTHER", "LET", "IN", "EXCEPT", "CHOOSE", "SUBSET", "UNION", "DOMAIN", "UNCHANGED",
    "ENABLED", "TRUE", "FALSE", "LAMBDA", "BOOLEAN", "STRING",
];

fn is_keyword(s: string) -> bool {
    for (let k: string in &keywords) { if (str::eq(k, s)) { return true; } }
    return false;
}

// An infix operator's precedence (0 if s is not one) and associativity (0 left, 1 right, 2 none).
fn infix(s: string) -> (i64, i64) {
    return match (s) {
        "=>" => (1, 1),
        "<=>" | "~>" => (2, 2),
        "/\\" | "\\/" => (3, 0),
        "=" | "/=" | "<" | ">" | "<=" | ">=" | "\\in" | "\\notin" | "\\subseteq" => (5, 2),
        "@@" => (6, 0),
        ":>" => (7, 2),
        "\\cup" | "\\cap" => (8, 0),
        "\\" => (8, 2),
        ".." => (9, 2),
        "+" | "-" => (10, 0),
        "%" => (10, 2),
        "\\X" => (10, 0),
        "*" | "\\o" => (13, 0),
        "\\div" => (13, 2),
        "^" => (14, 2),
        _ => (0, 0),
    };
}

fn binop(s: string) -> Op {
    return match (s) {
        "=>" => Op::Implies,
        "<=>" => Op::Equiv,
        "~>" => Op::LeadsTo,
        "=" => Op::Eq,
        "/=" => Op::Neq,
        "<" => Op::Lt,
        ">" => Op::Gt,
        "<=" => Op::Le,
        ">=" => Op::Ge,
        "\\in" => Op::In,
        "\\notin" => Op::NotIn,
        "\\subseteq" => Op::SubsetEq,
        "@@" => Op::AtAt,
        ":>" => Op::ColonGt,
        "\\cup" => Op::Cup,
        "\\cap" => Op::Cap,
        "\\" => Op::SetMinus,
        ".." => Op::Range,
        "+" => Op::Plus,
        "-" => Op::Minus,
        "%" => Op::Mod,
        "*" => Op::Times,
        "\\o" => Op::Concat,
        "\\div" => Op::Div,
        _ => Op::Pow,
    };
}

// The standard module an operator needs, or "" if it needs none.
fn std_of(s: string) -> string {
    return match (s) {
        "+" | "-" | "*" | "^" | "%" | "\\div" | ".." | "<" | ">" | "<=" | ">=" => "Naturals",
        "\\o" => "Sequences",
        ":>" | "@@" => "TLC",
        _ => "",
    };
}

fn has_std(m: string) -> bool {
    for (let s: string in &prog.std) {
        if (str::eq(s, m)) { return true; }
        // Integers extends Naturals.
        if (str::eq(m, "Naturals") && str::eq(s, "Integers")) { return true; }
    }
    return false;
}

// The builtins of standard module m, with arities; false if the subset lacks m.
fn add_std(m: string) -> bool {
    let names: string[] = match (m) {
        "Naturals" => ["Nat"],
        "Integers" => ["Nat", "Int"],
        "Sequences" => ["Seq", "Len", "Append", "Head", "Tail", "SubSeq"],
        "FiniteSets" => ["Cardinality", "IsFiniteSet"],
        "TLC" => ["Print", "PrintT", "Assert", "ToString", "Permutations"],
        _ => [],
    };
    if (names.len == 0) { return false; }
    for (let s: string in &names) {
        let arity: i64 = match (s) {
            "Nat" | "Int" => 0,
            "Append" | "Print" | "Assert" => 2,
            "SubSeq" => 3,
            _ => 1,
        };
        prog.globals.put(sym(s), Global { kind: Kind::Builtin, index: arity });
    }
    prog.std.push(std::copy(m));
    return true;
}

impl Parser {
    // Whether the current token is hidden by a bullet list's fence (or is the end).
    fn fenced(self: &Parser) -> bool {
        let t: &Token = &self.toks[self.i];
        if (t.kind == Tk::Eof) { return true; }
        let n: i64 = self.fences.len;
        return n > 0 && t.col <= self.fences[n - 1];
    }

    fn kind(self: &Parser) -> Tk {
        if (self.fenced()) { return Tk::Eof; }
        return self.toks[self.i].kind;
    }

    fn text(self: &Parser) -> string { return self.toks[self.i].text; }

    fn at_op(self: &Parser, s: string) -> bool {
        return self.kind() == Tk::Op && str::eq(self.toks[self.i].text, s);
    }

    fn at_kw(self: &Parser, s: string) -> bool {
        return self.kind() == Tk::Ident && str::eq(self.toks[self.i].text, s);
    }

    // Whether the token after the current one is operator s (ignoring the fence).
    fn then_op(self: &Parser, s: string) -> bool {
        let t: &Token = &self.toks[self.i + 1];
        return t.kind == Tk::Op && str::eq(t.text, s);
    }

    fn then_ident(self: &Parser, s: string) -> bool {
        let t: &Token = &self.toks[self.i + 1];
        return t.kind == Tk::Ident && str::eq(t.text, s);
    }

    fn skip(mut self: &Parser) -> void {
        if (self.toks[self.i].kind != Tk::Eof) { self.i += 1; }
    }

    fn err(self: &Parser, msg: string) -> ParseError {
        let t: &Token = &self.toks[self.i];
        var seen: string = t.text;
        if (t.kind == Tk::Eof) { seen = "the end"; }
        return ParseError { msg: "\(self.file):\(t.line):\(t.col): \(msg) (at \(seen))" };
    }

    fn expect_op(mut self: &Parser, s: string) -> void | ParseError {
        if (!self.at_op(s)) { fail self.err("expected \(s)"); }
        self.skip();
    }

    fn expect_kw(mut self: &Parser, s: string) -> void | ParseError {
        if (!self.at_kw(s)) { fail self.err("expected \(s)"); }
        self.skip();
    }

    fn ident(mut self: &Parser) -> string | ParseError {
        if (self.kind() != Tk::Ident || is_keyword(self.text())) { fail self.err("expected a name"); }
        let s: string = self.text();
        self.skip();
        return s;
    }

    fn node(self: &Parser, op: Op) -> Node {
        let t: &Token = &self.toks[self.i];
        return Node { op: op, line: t.line, col: t.col };
    }

    // The innermost binding of name s, or -1.
    fn find_bound(self: &Parser, s: i64) -> i64 {
        var k: i64 = self.bound.len - 1;
        while (k >= 0) {
            if (self.bound[k].sym == s) { return k; }
            k -= 1;
        }
        return -1;
    }

    // Binds s (arity as in Bound) unless the name is taken, which SANY also refuses.
    fn bind(mut self: &Parser, s: i64, arity: i64) -> void | ParseError {
        if (self.find_bound(s) >= 0 || prog.globals.has(s)) {
            fail self.err("\(name(s)) is already defined: TLA+ does not let a name be bound again");
        }
        self.bound.push(Bound { sym: s, arity: arity });
    }

    fn unbind(mut self: &Parser, n: i64) -> void {
        for (let k: i64 in 0..n) { self.bound.pop(); }
    }

    fn need_std(self: &Parser, op: string) -> void | ParseError {
        let m: string = std_of(op);
        if (m.len > 0 && !has_std(m)) { fail self.err("\(op) needs EXTENDS \(m)"); }
    }

    // ---- Expressions ----

    fn expr(mut self: &Parser, min: i64) -> i64 | ParseError {
        var left: i64 = self.prefix()?;
        var junction: string = "";          // The first /\ or \/ at this level.
        var last_none: i64 = 0;             // The last non-associative level applied.
        var cross: bool = false;            // left is an \X this loop made.
        while (self.kind() == Tk::Op) {
            let t: string = self.text();
            if (str::eq(t, "'") && min <= 15) {
                let nd: &Node = &prog.nodes[left];
                var ok: bool = nd.op == Op::Global;
                if (ok) { ok = glob(nd.sym).kind == Kind::Var; }
                if (!ok) { fail self.err("the subset primes only variables"); }
                var p: Node = self.node(Op::Prime);
                p.a = left;
                self.skip();
                left = add(p);
                continue;
            }
            if (str::eq(t, "[") && min <= 16) {
                var app: Node = self.node(Op::FnApp);
                self.skip();
                app.a = left;
                app.kids.push(self.expr(0)?);
                while (self.at_op(",")) {
                    self.skip();
                    app.kids.push(self.expr(0)?);
                }
                self.expect_op("]")?;
                left = add(app);
                continue;
            }
            if (str::eq(t, ".") && min <= 17) {
                var d: Node = self.node(Op::Dot);
                self.skip();
                d.a = left;
                if (self.kind() != Tk::Ident) { fail self.err("expected a field name"); }
                d.str = self.text();
                self.skip();
                left = add(d);
                continue;
            }
            let (p, assoc) = infix(t);
            if (p == 0 || p < min) { break; }
            if (str::eq(t, "~>") && !self.spec_ok) { fail self.err("~> is a temporal formula: checked only as a PROPERTY"); }
            if (assoc == 2 && p == last_none) { fail self.err("\(t) cannot follow an operator of its level without parentheses"); }
            self.need_std(t)?;
            if (str::eq(t, "/\\") || str::eq(t, "\\/")) {
                if (junction.len > 0 && !str::eq(junction, t)) {
                    fail self.err("/\\ and \\/ mixed without parentheses or bullets");
                }
                let first: bool = junction.len == 0;
                junction = t;
                let op: Op = match (t) { "/\\" => Op::And, _ => Op::Or };
                self.skip();
                let r: i64 = self.expr(p + 1)?;
                if (first) {
                    var j: Node = self.node(op);
                    j.kids.push(left);
                    j.kids.push(r);
                    left = add(j);
                } else {
                    prog.nodes[left].kids.push(r);
                }
                continue;
            }
            if (str::eq(t, "\\X")) {
                self.skip();
                let r: i64 = self.expr(p + 1)?;
                if (cross) {
                    prog.nodes[left].kids.push(r);
                } else {
                    var x: Node = self.node(Op::Cross);
                    x.kids.push(left);
                    x.kids.push(r);
                    left = add(x);
                    cross = true;
                }
                continue;
            }
            var b: Node = self.node(binop(t));
            self.skip();
            b.a = left;
            if (assoc == 1) {
                b.b = self.expr(p)?;
            } else {
                b.b = self.expr(p + 1)?;
            }
            left = add(b);
            cross = false;
            if (assoc == 2) { last_none = p; }
        }
        return left;
    }

    fn unary(mut self: &Parser, op: Op, min: i64) -> i64 | ParseError {
        var n: Node = self.node(op);
        self.skip();
        n.a = self.expr(min)?;
        return add(n);
    }

    fn prefix(mut self: &Parser) -> i64 | ParseError {
        let k: Tk = self.kind();
        if (k == Tk::Eof) { fail self.err("expected an expression"); }
        if (k == Tk::Num) {
            var n: Node = self.node(Op::Num);
            n.num = self.toks[self.i].num;
            self.skip();
            return add(n);
        }
        if (k == Tk::Str) {
            var n: Node = self.node(Op::Str);
            n.str = self.text();
            self.skip();
            return add(n);
        }
        if (k == Tk::Ident) { return self.word(); }
        let t: string = self.text();
        match (t) {
            "(" => {
                self.skip();
                let e: i64 = self.expr(0)?;
                self.expect_op(")")?;
                return e;
            },
            "<<" => {
                var n: Node = self.node(Op::Tuple);
                self.skip();
                if (!self.at_op(">>")) {
                    n.kids.push(self.expr(0)?);
                    while (self.at_op(",")) {
                        self.skip();
                        n.kids.push(self.expr(0)?);
                    }
                }
                self.expect_op(">>")?;
                return add(n);
            },
            "{" => { return self.braces(); },
            "[" => { return self.brackets(); },
            "~" => { return self.unary(Op::Not, 4); },
            "-" => {
                if (!has_std("Integers")) { fail self.err("unary - needs EXTENDS Integers"); }
                return self.unary(Op::Neg, 12);
            },
            "/\\" | "\\/" => { return self.bullets(); },
            "\\A" | "\\E" => { return self.quantifier(); },
            "@" => {
                if (self.excepts == 0) { fail self.err("@ outside an EXCEPT"); }
                let n: Node = self.node(Op::At);
                self.skip();
                return add(n);
            },
            "[]" => {
                if (!self.spec_ok) { fail self.err("temporal formulas are checked only as a SPECIFICATION's Init /\\ [][Next]_vars"); }
                return self.unary(Op::Box, 4);
            },
            "<>" => {
                if (!self.spec_ok) { fail self.err("temporal formulas are checked only as a SPECIFICATION or a PROPERTY"); }
                return self.unary(Op::Diamond, 4);
            },
            _ => {},
        }
        fail self.err("the subset has no expression that starts here");
    }

    // A word: a keyword's construct, a literal, or a name.
    fn word(mut self: &Parser) -> i64 | ParseError {
        let w: string = self.text();
        match (w) {
            "TRUE" | "FALSE" => {
                var n: Node = self.node(Op::Bool);
                if (str::eq(w, "TRUE")) { n.num = 1; }
                self.skip();
                return add(n);
            },
            "IF" => {
                var n: Node = self.node(Op::If);
                self.skip();
                n.a = self.expr(0)?;
                self.expect_kw("THEN")?;
                n.b = self.expr(0)?;
                self.expect_kw("ELSE")?;
                n.c = self.expr(0)?;
                return add(n);
            },
            "CASE" => { return self.case_of(); },
            "LET" => { return self.let_in(); },
            "CHOOSE" => {
                var n: Node = self.node(Op::Choose);
                self.skip();
                let x: i64 = sym(self.ident()?);
                if (!self.at_op("\\in")) { fail self.err("the subset needs CHOOSE x \\in S"); }
                self.skip();
                n.a = self.expr(0)?;
                self.expect_op(":")?;
                self.bind(x, -1)?;
                n.b = self.expr(0)?;
                self.unbind(1);
                n.syms.push(x);
                return add(n);
            },
            "SUBSET" => { return self.unary(Op::Powerset, 9); },
            "UNION" => { return self.unary(Op::BigUnion, 9); },
            "DOMAIN" => { return self.unary(Op::Domain, 10); },
            "UNCHANGED" => { return self.unary(Op::Unchanged, 5); },
            "ENABLED" | "LAMBDA" | "INSTANCE" => { fail self.err("the subset has no \(w)"); },
            _ => {},
        }
        if (is_keyword(w) && !str::eq(w, "BOOLEAN") && !str::eq(w, "STRING")) {
            fail self.err("\(w) cannot start an expression");
        }
        // WF_vars(A) and SF_vars(A): fairness, which a safety check may ignore
        if (w.len > 3 && (str::eq(w[0..3], "WF_") || str::eq(w[0..3], "SF_"))) {
            if (!self.spec_ok) { fail self.err("fairness is read only in a SPECIFICATION"); }
            var n: Node = self.node(Op::Fair);
            if (str::eq(w[0..3], "SF_")) { n.num = 1; }
            self.skip();
            self.expect_op("(")?;
            n.a = self.expr(0)?;
            self.expect_op(")")?;
            return add(n);
        }
        let s: i64 = sym(w);
        var n: Node = self.node(Op::Global);
        n.sym = s;
        self.skip();
        if (self.at_op("!")) { fail self.err("the subset has no instances (M!Op)"); }
        let b: i64 = self.find_bound(s);
        var arity: i64 = -1;
        if (b >= 0) {
            n.op = Op::Local;
            arity = self.bound[b].arity;
        } else {
            if (!prog.globals.has(s)) {
                fail self.err("unknown name \(w): a name must be defined before it is used");
            }
            let g: Global = glob(s);
            arity = match (g.kind) {
                Kind::Def => g.params.len,
                Kind::Builtin => g.index,
                _ => 0,
            };
        }
        if (self.at_op("(")) {
            if (arity <= 0) { fail self.err("\(w) takes no arguments"); }
            n.op = Op::Call;
            if (b >= 0) { n.num = 1; }
            self.skip();
            n.kids.push(self.expr(0)?);
            while (self.at_op(",")) {
                self.skip();
                n.kids.push(self.expr(0)?);
            }
            self.expect_op(")")?;
            if (n.kids.len != arity) { fail self.err("\(w) takes \(arity) arguments, not \(n.kids.len)"); }
            return add(n);
        }
        if (arity > 0) { fail self.err("\(w) needs its \(arity) arguments: the subset has no operators as values"); }
        return add(n);
    }

    // \A x \in S, y \in T : P and \E ...
    fn quantifier(mut self: &Parser) -> i64 | ParseError {
        var op: Op = Op::Exists;
        if (str::eq(self.text(), "\\A")) { op = Op::Forall; }
        var n: Node = self.node(op);
        self.skip();
        self.bounds(mut &n)?;
        self.expect_op(":")?;
        for (let s: i64 in &n.syms) { self.bind(s, -1)?; }
        n.b = self.expr(0)?;
        self.unbind(n.syms.len);
        return add(n);
    }

    // x \in S, y, z \in T: into n.syms and n.kids, one set per name. Names are not bound yet,
    // and the sets cannot use them (they are in scope only after the colon).
    fn bounds(mut self: &Parser, mut n: &Node) -> void | ParseError {
        while (true) {
            if (self.at_op("<<")) { fail self.err("the subset has no tuple binders (<<x, y>> \\in S)"); }
            var group: i64[] = [];
            group.push(sym(self.ident()?));
            while (self.at_op(",")) {
                self.skip();
                group.push(sym(self.ident()?));
            }
            if (!self.at_op("\\in")) { fail self.err("the subset needs bounded quantifiers (x \\in S)"); }
            self.skip();
            let set: i64 = self.expr(0)?;
            for (let s: i64 in &group) {
                n.syms.push(s);
                n.kids.push(set);
            }
            if (!self.at_op(",")) { break; }
            self.skip();
        }
    }

    // A bullet list: /\ a  /\ b  ..., all bullets in one column.
    fn bullets(mut self: &Parser) -> i64 | ParseError {
        let bullet: string = self.text();
        let col: i64 = self.toks[self.i].col;
        var op: Op = Op::Or;
        if (str::eq(bullet, "/\\")) { op = Op::And; }
        var n: Node = self.node(op);
        self.fences.push(col);
        while (true) {
            self.i += 1;                    // the bullet
            n.kids.push(self.expr(0)?);
            let t: &Token = &self.toks[self.i];
            if (t.kind != Tk::Op || t.col != col || !str::eq(t.text, bullet)) { break; }
        }
        self.fences.pop();
        let t: &Token = &self.toks[self.i];
        if (t.kind == Tk::Op && t.col == col && (str::eq(t.text, "/\\") || str::eq(t.text, "\\/"))) {
            fail self.err("a list of \(bullet) continued by another bullet in its column");
        }
        return add(n);
    }

    fn case_of(mut self: &Parser) -> i64 | ParseError {
        var n: Node = self.node(Op::Case);
        self.skip();
        while (true) {
            if (self.at_kw("OTHER")) {
                self.skip();
                self.expect_op("->")?;
                n.c = self.expr(0)?;
                break;
            }
            var arm: Node = self.node(Op::CaseArm);
            arm.a = self.expr(0)?;
            self.expect_op("->")?;
            arm.b = self.expr(0)?;
            n.kids.push(add(arm));
            if (!self.at_op("[]")) { break; }
            self.skip();
        }
        return add(n);
    }

    fn let_in(mut self: &Parser) -> i64 | ParseError {
        var n: Node = self.node(Op::Let);
        self.skip();
        var defs: i64 = 0;
        while (!self.at_kw("IN")) {
            let d: i64 = self.definition(true)?;
            let s: i64 = prog.nodes[d].sym;
            let arity: i64 = prog.nodes[d].syms.len;
            self.bind(s, arity)?;
            defs += 1;
            n.kids.push(d);
        }
        if (defs == 0) { fail self.err("a LET with no definitions"); }
        self.skip();
        n.b = self.expr(0)?;
        self.unbind(defs);
        return add(n);
    }

    // {a, b}, {x \in S : P} and {e : x \in S}.
    fn braces(mut self: &Parser) -> i64 | ParseError {
        var n: Node = self.node(Op::SetEnum);
        self.skip();
        if (self.at_op("}")) {
            self.skip();
            return add(n);
        }
        // {x \in S : P} if a colon follows S; otherwise {x \in S, ...} is a set of booleans.
        if (self.kind() == Tk::Ident && self.then_op("\\in") && !is_keyword(self.text())) {
            let start: i64 = self.i;
            let x: i64 = sym(self.text());
            self.i += 2;
            let set: i64 = self.expr(0)?;
            if (self.at_op(":")) {
                self.skip();
                n.op = Op::SetFilter;
                n.a = set;
                n.syms.push(x);
                self.bind(x, -1)?;
                n.b = self.expr(0)?;
                self.unbind(1);
                self.expect_op("}")?;
                return add(n);
            }
            self.i = start;
        }
        // {e : x \in S}: read the bounds after the colon first so e can use them.
        let colon: i64 = self.map_colon();
        if (colon >= 0) {
            let start: i64 = self.i;
            n.op = Op::SetMap;
            self.i = colon + 1;
            self.bounds(mut &n)?;
            let end: i64 = self.i;
            for (let s: i64 in &n.syms) { self.bind(s, -1)?; }
            self.i = start;
            n.a = self.expr(0)?;
            if (self.i != colon) { fail self.err("expected : in {e : x \\in S}"); }
            self.i = end;
            self.unbind(n.syms.len);
            self.expect_op("}")?;
            return add(n);
        }
        n.kids.push(self.expr(0)?);
        while (self.at_op(",")) {
            self.skip();
            n.kids.push(self.expr(0)?);
        }
        self.expect_op("}")?;
        return add(n);
    }

    // Index of the colon of {e : x \in S} from here, or -1. Colons taken by a quantifier or
    // CHOOSE in e, or inside brackets, do not count.
    fn map_colon(self: &Parser) -> i64 {
        var depth: i64 = 0;
        var owed: i64 = 0;                  // colons owed to quantifiers in e
        var j: i64 = self.i;
        while (j < self.toks.len) {
            let t: &Token = &self.toks[j];
            if (t.kind == Tk::Eof) { return -1; }
            if (t.kind == Tk::Op) {
                match (t.text) {
                    "(" | "[" | "{" | "<<" => { depth += 1; },
                    ")" | "]" | ">>" => { depth -= 1; },
                    "}" => {
                        if (depth == 0) { return -1; }
                        depth -= 1;
                    },
                    "\\A" | "\\E" => { if (depth == 0) { owed += 1; } },
                    ":" => {
                        if (depth == 0) {
                            if (owed == 0) { return j; }
                            owed -= 1;
                        }
                    },
                    _ => {},
                }
            } else if (t.kind == Tk::Ident && str::eq(t.text, "CHOOSE") && depth == 0) {
                owed += 1;
            }
            j += 1;
        }
        return -1;
    }

    // [x \in S |-> e], [S -> T], [a |-> e], [a : S], [f EXCEPT ...] and [A]_v.
    fn brackets(mut self: &Parser) -> i64 | ParseError {
        var n: Node = self.node(Op::RecCons);
        self.skip();
        let word: bool = self.kind() == Tk::Ident && !is_keyword(self.text());
        if (word && (self.then_op("|->") || self.then_op(":"))) {
            var sep: string = "|->";
            if (self.then_op(":")) {
                n.op = Op::RecSet;
                sep = ":";
            }
            while (true) {
                let f: string = self.ident()?;
                for (let g: string in &n.strs) {
                    if (str::eq(g, f)) { fail self.err("the field \(f) twice"); }
                }
                n.strs.push(f);
                self.expect_op(sep)?;
                n.kids.push(self.expr(0)?);
                if (!self.at_op(",")) { break; }
                self.skip();
            }
            self.expect_op("]")?;
            return add(n);
        }
        if (word && (self.then_op("\\in") || self.then_op(","))) {
            n.op = Op::FnCons;
            self.bounds(mut &n)?;
            self.expect_op("|->")?;
            for (let s: i64 in &n.syms) { self.bind(s, -1)?; }
            n.b = self.expr(0)?;
            self.unbind(n.syms.len);
            self.expect_op("]")?;
            return add(n);
        }
        let e: i64 = self.expr(0)?;
        if (self.at_kw("EXCEPT")) {
            n.op = Op::Except;
            n.a = e;
            self.skip();
            while (true) {
                var item: Node = self.node(Op::ExceptItem);
                self.expect_op("!")?;
                while (!self.at_op("=")) {
                    if (self.at_op(".")) {
                        self.skip();
                        var f: Node = self.node(Op::Str);
                        f.str = self.ident()?;
                        item.kids.push(add(f));
                    } else {
                        var t: Node = self.node(Op::Tuple);
        }
    }
}

// Parses src (from file, in directory dir) into prog.
fn parse_into(src: string, file: string, dir: string) -> void | ParseError {
    let l: Lexed = lex(src);
    if (l.error.len > 0) { fail ParseError { msg: "\(file):\(l.error)" }; }
    var p: Parser = Parser { toks: std::copy(l.toks), file: file, dir: dir };
    p.module()?;
}

/// Parses the module in file (text: src) into prog, which starts empty.
export fn parse(src: string, file: string) -> void | ParseError {
    prog = Prog {};
    prog.globals.put(sym("BOOLEAN"), Global { kind: Kind::Builtin, index: 0 });
    prog.globals.put(sym("STRING"), Global { kind: Kind::Builtin, index: 0 });
    prog.at = sym("@");
    var dir: string = "";
    var k: i64 = file.len - 1;
    while (k >= 0 && file[k] != '/') { k -= 1; }
    if (k > 0) { dir = file[0..k]; }
    var base: string = file[k + 1..];
    if (base.len > 4 && str::eq(base[base.len - 4..], ".tla")) { base = base[0..base.len - 4]; }
    prog.module = base;
    let l: Lexed = lex(src);
    if (l.error.len > 0) { fail ParseError { msg: "\(file):\(l.error)" }; }
    var p: Parser = Parser { toks: std::copy(l.toks), file: file, dir: dir };
    let m: string = p.module()?;
    if (!str::eq(m, base)) { fail ParseError { msg: "\(file): the module is named \(m), not \(base)" }; }
}
