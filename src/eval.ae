// Evaluation for tla: expressions to values (value.ae), and actions to their successor states,
// as TLC finds them.
//
// * Environments are binding chains in one arena (Envs), so an operator's body sees its
//   parameters and, for a LET definition, the scope it was written in, never its caller's. The
//   arena is emptied after each state (reset_envs); no environment outlives that.
// * Actions are read as TLC reads them: left to right, with a stack of remaining work. x' = e
//   sets x' if unset (otherwise it is a test), x' \in S tries each element, \/ and \E try each
//   branch, IF and CASE take the branch their condition picks, and definitions open in place.
//   Anything else is a condition on what is set so far. A successor is found when nothing is
//   left and every variable is set; an unset variable is an error.
// * Init is read the same way, with x = e and x \in S setting unprimed variables.
// * A parameterless definition that uses no variable (so cannot depend on the state) is
//   computed once.

import { Map, Set } from "std/containers";
import { Op, Node, Kind, Global, prog, name, pos, glob } from "ast.ae";
import {
    EvalError, Tag, vt, FALSE, TRUE, is_int, int_of, mk_int, small, mk_bool, mk_str, tag, is_tag,
    xs, ys, size, mk_set, mk_set_sorted, mk_func, mk_func_sorted, mk_tuple, mk_rec, mk_recset,
    lazy, is_set, find, is_seq, apply, lookup, update, member, expand, elements, show,
} from "value.ae";
import str from "std/string";

let UNSET: i64 = -1;

// A binding: sym to a value (kind 0) or to a LET definition (kind 1: val is the LetDef node,
// its scope parent).
struct Envs {
    syms: i64[] = [];
    vals: i64[] = [];
    kinds: i64[] = [];
    parents: i64[] = [];
}

// An action's remaining work: node, in env.
struct Item {
    node: i64;
    env: i64;
    ctx: string;                        // The innermost definition it is in (for labels).
}

/// Evaluator state.
export struct Cx {
    export cur: i64[] = [];             // Current state: a value per variable.
    export nxt: i64[] = [];             // Next state being built (UNSET if not set yet).
    export init: bool = false;          // Reading Init: setting unprimed variables.
    export consts: i64[] = [];          // A value per constant.
    memo: Map(i64, i64) = Map {};       // Constant definitions' values.
    level: Map(i64, bool) = Map {};     // Whether a definition is constant.
    visiting: Set(i64) = Set {};        // Definitions whose level is being found.
    envs: Envs = Envs {};
    todo: Item[] = [];
    export label: string = "";          // How the state being built was reached: the innermost
                                        //   definition open when a variable was first set.
    fixed: bool = false;                // Whether label is set for this state.
    ctx: string = "";                   // Definition the current item is written in.
    export found: i64[] = [];           // States found, each a tuple of the variables.
    export labels: string[] = [];
    export at: i64 = -1;                // Node being evaluated, for errors.
}

export var cx: Cx = Cx {};

/// Resets for a new spec (after parse); consts holds the constants' values.
export fn start(consts: i64[]) -> void {
    cx = Cx { consts: consts };
    let n: i64 = prog.vars.len;
    var cur: i64[n];
    var nxt: i64[n];
    cx.cur = cur;
    cx.nxt = nxt;
}

/// Empties the environment arena.
export fn reset_envs() -> void { cx.envs = Envs {}; }

/// Pushes onto out the values the evaluator keeps between evaluations: the constants', then
/// the constant definitions' (value::compact's roots).
export fn value_roots(mut out: &i64[]) -> void {
    for (let v: i64 in &cx.consts) { out.push(v); }
    for (let s: i64 in 0..cx.memo.cap()) {
        if (cx.memo.full(s)) { out.push(cx.memo.entry(s).val); }
    }
}

/// After value::compact renumbers value_roots' values, takes them back from roots, starting at
/// at; returns where they end. Drops what an evaluation leaves (found states, environments).
export fn reroot(roots: &i64[], at: i64) -> i64 {
    var i: i64 = at;
    for (let k: i64 in 0..cx.consts.len) {
        cx.consts[k] = roots[i];
        i += 1;
    }
    var memo: Map(i64, i64) = Map {};
    for (let s: i64 in 0..cx.memo.cap()) {
        if (cx.memo.full(s)) {
            memo.put(cx.memo.entry(s).key, roots[i]);
            i += 1;
        }
    }
    cx.memo = memo;
    for (let k: i64 in 0..cx.cur.len) { cx.cur[k] = UNSET; }
    for (let k: i64 in 0..cx.nxt.len) { cx.nxt[k] = UNSET; }
    cx.found = [];
    cx.labels = [];
    reset_envs();
    return i;
}

fn bind(s: i64, v: i64, kind: i64, parent: i64) -> i64 {
    cx.envs.syms.push(s);
    cx.envs.vals.push(v);
    cx.envs.kinds.push(kind);
    cx.envs.parents.push(parent);
    return cx.envs.syms.len - 1;
}

fn find_env(s: i64, env: i64) -> i64 {
    var e: i64 = env;
    while (e >= 0) {
        if (cx.envs.syms[e] == s) { return e; }
        e = cx.envs.parents[e];
    }
    return -1;
}

// An error at the node being evaluated. (value.ae errors have no position: whoever reports an
// EvalError adds it with where().)
fn err(msg: string) -> EvalError { return EvalError { msg: msg }; }

/// The node being evaluated when the last error happened.
export fn where_at() -> string {
    if (cx.at >= 0) { return pos(cx.at); }
    return prog.module;
}

// v as a variable's value: finite at every depth, as TLC needs to store it.
fn storable(v: i64) -> i64 | EvalError {
    let w: i64 = norm(v)?;
    if (is_int(w)) { return w; }
    match (tag(w)) {
        Tag::Nat | Tag::Int | Tag::Strings | Tag::SeqSet => {
            fail err("a variable cannot hold the infinite set \(show(w))");
        },
        Tag::Set => { for (let e: i64 in xs(w)) { storable(e)?; } },
        Tag::Func => { for (let e: i64 in ys(w)) { storable(e)?; } },
        _ => {},
    }
    return w;
}

// A finite lazy set is expanded before going into a value, so equal values keep equal ids.
fn norm(v: i64) -> i64 | EvalError {
    if (is_int(v)) { return v; }
    return match (tag(v)) {
        Tag::Pow | Tag::FnSet | Tag::RecSet => expand(v)?,
        _ => v,
    };
}

fn int(v: i64) -> i64 | EvalError {
    if (!is_int(v)) { fail err("expected an integer, not \(show(v))"); }
    return int_of(v);
}

fn boolean(v: i64) -> bool | EvalError {
    if (v == TRUE) { return true; }
    if (v != FALSE) { fail err("expected a boolean, not \(show(v))"); }
    return false;
}

fn eq(a: i64, b: i64) -> bool | EvalError {
    if (a == b) { return true; }
    return norm(a)? == norm(b)?;
}

fn var_value(index: i64, primed: bool) -> i64 | EvalError {
    if (primed || cx.init) {
        let v: i64 = cx.nxt[index];
        if (v == UNSET) {
            var tick: string = "";
            if (primed) { tick = "'"; }
            fail err("\(name(prog.vars[index]))\(tick) is read before it is set");
        }
        return v;
    }
    return cx.cur[index];
}

// Whether definition s cannot depend on the state. A recursive definition counts as constant
// while being examined (largest fixed point); a "constant" result under that assumption is kept
// only once the outermost definition is done, a "not constant" one at once (it found a variable).
export fn constant_def(s: i64) -> bool {
    if (let c = cx.level.get(s)) { return c; }
    if (cx.visiting.has(s)) { return true; }
    cx.visiting.add(s);
    let g: Global = glob(s);
    let c: bool = constant_node(g.body);
    cx.visiting.remove(s);
    if (!c || cx.visiting.len() == 0) { cx.level.put(s, c); }
    return c;
}

/// Whether node n cannot depend on the state.
export fn constant_node(n: i64) -> bool {
    if (n < 0) { return true; }
    let nd: &Node = &prog.nodes[n];
    match (nd.op) {
        Op::Prime | Op::Unchanged => { return false; },
        Op::Global | Op::Call => {
            if (nd.op == Op::Call && nd.num == 1) {
                // a LET definition: its body is in this tree
            } else {
                let g: Global = glob(nd.sym);
                if (g.kind == Kind::Var) { return false; }
                if (g.kind == Kind::Def && !constant_def(nd.sym)) { return false; }
                if (g.kind == Kind::Builtin) {
                    // Print and Assert are effects; keep them in place.
                    let w: string = name(nd.sym);
                    if (str::eq(w, "Print") || str::eq(w, "PrintT") || str::eq(w, "Assert")) { return false; }
                }
            }
        },
        _ => {},
    }
    if (!constant_node(nd.a) || !constant_node(nd.b) || !constant_node(nd.c)) { return false; }
    for (let k: i64 in &nd.kids) { if (!constant_node(k)) { return false; } }
    return true;
}

// The values of n's bounds (syms over kids), each an expanded set.
fn bound_sets(n: i64, env: i64) -> i64[][] | EvalError {
    var sets: i64[][] = [];
    let kids: i64[] = std::copy(prog.nodes[n].kids);
    for (let k: i64 in &kids) { sets.push(elements(eval(k, env)?)?); }
    return sets;
}

// Advances pick to the next combination of sets' elements; false after the last.
fn advance(mut pick: &i64[], sets: &i64[][]) -> bool {
    var i: i64 = pick.len - 1;
    while (i >= 0) {
        pick[i] += 1;
        if (pick[i] < sets[i].len) { return true; }
        pick[i] = 0;
        i -= 1;
    }
    return false;
}

fn any_empty(sets: &i64[][]) -> bool {
    for (let s: &i64[] in sets) { if (s.len == 0) { return true; } }
    return false;
}

// env with syms bound to the elements pick chooses.
fn bind_pick(syms: &i64[], sets: &i64[][], pick: &i64[], env: i64) -> i64 {
    var e: i64 = env;
    for (let i: i64 in 0..syms.len) { e = bind(syms[i], sets[i][pick[i]], 0, e); }
    return e;
}

// The environment for calling def (params bound to args) in scope.
fn call_env(params: &i64[], args: &i64[], scope: i64) -> i64 {
    var e: i64 = scope;
    for (let i: i64 in 0..params.len) { e = bind(params[i], args[i], 0, e); }
    return e;
}

fn eval_args(n: i64, env: i64) -> i64[] | EvalError {
    var args: i64[] = [];
    let kids: i64[] = std::copy(prog.nodes[n].kids);
    for (let k: i64 in &kids) { args.push(eval(k, env)?); }
    return args;
}

/// The value of node n in env.
export fn eval(n: i64, env: i64) -> i64 | EvalError {
    cx.at = n;
    let op: Op = prog.nodes[n].op;
    match (op) {
        Op::Num => { return mk_int(prog.nodes[n].num)?; },
        Op::Str => { return mk_str(prog.nodes[n].str); },
        Op::Bool => { return mk_bool(prog.nodes[n].num == 1); },
        Op::Local => {
            let e: i64 = find_env(prog.nodes[n].sym, env);
            if (e < 0) { fail err("\(name(prog.nodes[n].sym)) is not bound here"); }
            if (cx.envs.kinds[e] == 0) { return cx.envs.vals[e]; }
            return eval(prog.nodes[cx.envs.vals[e]].b, cx.envs.parents[e]);
        },
        Op::Global => { return global(n); },
        Op::Call => {
            let args: i64[] = eval_args(n, env)?;
            cx.at = n;
            let s: i64 = prog.nodes[n].sym;
            if (prog.nodes[n].num == 1) {
                let e: i64 = find_env(s, env);
                let d: i64 = cx.envs.vals[e];
                let params: i64[] = std::copy(prog.nodes[d].syms);
                return eval(prog.nodes[d].b, call_env(&params, &args, cx.envs.parents[e]));
            }
            let g: Global = glob(s);
            if (g.kind == Kind::Builtin) { return builtin(name(s), &args); }
            if (g.body < 0) { fail err("\(name(s)) is declared RECURSIVE but never defined"); }
            return eval(g.body, call_env(&g.params, &args, -1));
        },
        Op::Prime => {
            let g: Global = glob(prog.nodes[prog.nodes[n].a].sym);
            if (cx.init) { fail err("a primed variable in Init"); }
            return var_value(g.index, true);
        },
        Op::Not => { return mk_bool(!boolean(eval(prog.nodes[n].a, env)?)?); },
        Op::Neg => { return mk_int(-int(eval(prog.nodes[n].a, env)?)?)?; },
        Op::Powerset => {
            let s: i64 = eval(prog.nodes[n].a, env)?;
            if (!is_set(s)) { fail err("SUBSET of \(show(s)), which is not a set"); }
            return lazy(Tag::Pow, s, 0);
        },
        Op::BigUnion => {
            var out: i64[] = [];
            for (let s: i64 in elements(eval(prog.nodes[n].a, env)?)?) {
                for (let e: i64 in elements(s)?) { out.push(e); }
            }
            return mk_set(out);
        },
        Op::Domain => {
            let f: i64 = eval(prog.nodes[n].a, env)?;
            if (!is_tag(f, Tag::Func)) { fail err("DOMAIN of \(show(f)), which is not a function"); }
            return mk_set_sorted(xs(f));
        },
        Op::Unchanged => {
            var vars: i64[] = [];
            unchanged_vars(prog.nodes[n].a, mut &vars)?;
            for (let i: i64 in &vars) {
                if (!eq(var_value(i, true)?, cx.cur[i])?) { return FALSE; }
            }
            return TRUE;
        },
        Op::And => {
            let kids: i64[] = std::copy(prog.nodes[n].kids);
            for (let k: i64 in &kids) { if (!boolean(eval(k, env)?)?) { return FALSE; } }
            return TRUE;
        },
        Op::Or => {
            let kids: i64[] = std::copy(prog.nodes[n].kids);
            for (let k: i64 in &kids) { if (boolean(eval(k, env)?)?) { return TRUE; } }
            return FALSE;
        },
        Op::Implies => {
            if (!boolean(eval(prog.nodes[n].a, env)?)?) { return TRUE; }
            return mk_bool(boolean(eval(prog.nodes[n].b, env)?)?);
        },
        Op::Equiv => {
            let a: bool = boolean(eval(prog.nodes[n].a, env)?)?;
            return mk_bool(a == boolean(eval(prog.nodes[n].b, env)?)?);
        },
        Op::Eq => { return mk_bool(eq(eval(prog.nodes[n].a, env)?, eval(prog.nodes[n].b, env)?)?); },
        Op::Neq => { return mk_bool(!eq(eval(prog.nodes[n].a, env)?, eval(prog.nodes[n].b, env)?)?); },
        Op::Lt | Op::Gt | Op::Le | Op::Ge | Op::Plus | Op::Minus | Op::Times | Op::Div | Op::Mod | Op::Pow | Op::Range => {
            let a: i64 = int(eval(prog.nodes[n].a, env)?)?;
            let b: i64 = int(eval(prog.nodes[n].b, env)?)?;
            cx.at = n;
            return arith(op, a, b);
        },
        Op::In => { return mk_bool(member(eval(prog.nodes[n].a, env)?, eval(prog.nodes[n].b, env)?)?); },
        Op::NotIn => { return mk_bool(!member(eval(prog.nodes[n].a, env)?, eval(prog.nodes[n].b, env)?)?); },
        Op::SubsetEq => {
            let a: i64 = eval(prog.nodes[n].a, env)?;
            let b: i64 = eval(prog.nodes[n].b, env)?;
            for (let e: i64 in elements(a)?) { if (!member(e, b)?) { return FALSE; } }
            return TRUE;
        },
        Op::Cup => {
            var out: i64[] = elements(eval(prog.nodes[n].a, env)?)?;
            for (let e: i64 in elements(eval(prog.nodes[n].b, env)?)?) { out.push(e); }
            return mk_set(out);
        },
        Op::Cap | Op::SetMinus => {
            let a: i64[] = elements(eval(prog.nodes[n].a, env)?)?;
            let b: i64 = eval(prog.nodes[n].b, env)?;
            if (!is_set(b)) { fail err("\(show(b)) is not a set"); }
            var out: i64[] = [];
            for (let e: i64 in &a) {
                if (member(e, b)? == (op == Op::Cap)) { out.push(e); }
            }
            return mk_set_sorted(out);
        },
        Op::Concat => {
            let a: i64 = eval(prog.nodes[n].a, env)?;
            let b: i64 = eval(prog.nodes[n].b, env)?;
            if (!is_seq(a) || !is_seq(b)) { fail err("\\o of \(show(a)) and \(show(b)): both must be sequences"); }
            var out: i64[] = ys(a);
            for (let e: i64 in ys(b)) { out.push(e); }
            return mk_tuple(out);
        },
        Op::ColonGt => {
            let a: i64 = norm(eval(prog.nodes[n].a, env)?)?;
            let b: i64 = norm(eval(prog.nodes[n].b, env)?)?;
            return mk_func_sorted([a], [b]);
        },
        Op::AtAt => {
            let f: i64 = eval(prog.nodes[n].a, env)?;
            let g: i64 = eval(prog.nodes[n].b, env)?;
            if (!is_tag(f, Tag::Func) || !is_tag(g, Tag::Func)) { fail err("@@ of \(show(f)) and \(show(g)): both must be functions"); }
            var d: i64[] = xs(f);
            var r: i64[] = ys(f);
            let gd: i64[] = xs(g);
            let gr: i64[] = ys(g);
            for (let i: i64 in 0..gd.len) {
                if (find(&vt.nodes[f >> 1].xs, gd[i]) < 0) {
                    d.push(gd[i]);
                    r.push(gr[i]);
                }
            }
            return mk_func(&d, &r)?;
        },
        Op::Cross => {
            var sets: i64[][] = [];
            let kids: i64[] = std::copy(prog.nodes[n].kids);
            for (let k: i64 in &kids) { sets.push(elements(eval(k, env)?)?); }
            var out: i64[] = [];
            if (any_empty(&sets)) { return mk_set_sorted([]); }
            var pick: i64[sets.len];
            while (true) {
                var t: i64[] = [];
                for (let i: i64 in 0..sets.len) { t.push(sets[i][pick[i]]); }
                out.push(mk_tuple(t));
                if (!advance(mut &pick, &sets)) { break; }
            }
            return mk_set(out);
        },
        Op::FnApp => {
            let f: i64 = eval(prog.nodes[n].a, env)?;
            let args: i64[] = eval_args(n, env)?;
            cx.at = n;
            var key: i64 = args[0];
            if (args.len > 1) { key = mk_tuple(args); }
            return apply(f, norm(key)?)?;
        },
        Op::Dot => {
            let r: i64 = eval(prog.nodes[n].a, env)?;
            cx.at = n;
            if (!is_tag(r, Tag::Func)) { fail err("the field .\(prog.nodes[n].str) of \(show(r)), which is not a record"); }
            return apply(r, mk_str(prog.nodes[n].str))?;
        },
        Op::SetEnum => {
            var out: i64[] = [];
            let kids: i64[] = std::copy(prog.nodes[n].kids);
            for (let k: i64 in &kids) { out.push(norm(eval(k, env)?)?); }
            return mk_set(out);
        },
        Op::Tuple => {
            var out: i64[] = [];
            let kids: i64[] = std::copy(prog.nodes[n].kids);
            for (let k: i64 in &kids) { out.push(norm(eval(k, env)?)?); }
            return mk_tuple(out);
        },
        Op::SetFilter => {
            let x: i64 = prog.nodes[n].syms[0];
            let body: i64 = prog.nodes[n].b;
            var out: i64[] = [];
            for (let e: i64 in elements(eval(prog.nodes[n].a, env)?)?) {
                if (boolean(eval(body, bind(x, e, 0, env))?)?) { out.push(e); }
            }
            return mk_set_sorted(out);
        },
        Op::SetMap | Op::FnCons | Op::Forall | Op::Exists => {
            let syms: i64[] = std::copy(prog.nodes[n].syms);
            let sets: i64[][] = bound_sets(n, env)?;
            var body: i64 = prog.nodes[n].b;
            if (op == Op::SetMap) { body = prog.nodes[n].a; }
            var keys: i64[] = [];
            var vals: i64[] = [];
            if (!any_empty(&sets)) {
                var pick: i64[syms.len];
                while (true) {
                    let e: i64 = bind_pick(&syms, &sets, &pick, env);
                    let v: i64 = eval(body, e)?;
                    match (op) {
                        Op::Forall => { if (!boolean(v)?) { return FALSE; } },
                        Op::Exists => { if (boolean(v)?) { return TRUE; } },
                        _ => {
                            vals.push(norm(v)?);
                            if (op == Op::FnCons) {
                                var key: i64 = sets[0][pick[0]];
                                if (syms.len > 1) {
                                    var t: i64[] = [];
                                    for (let i: i64 in 0..syms.len) { t.push(sets[i][pick[i]]); }
                                    key = mk_tuple(t);
                                }
                                keys.push(key);
                            }
                        },
                    }
                    if (!advance(mut &pick, &sets)) { break; }
                }
            }
            return match (op) {
                Op::Forall => TRUE,
                Op::Exists => FALSE,
                Op::SetMap => mk_set(vals),
                _ => mk_func(&keys, &vals)?,
            };
        },
        Op::Choose => {
            let x: i64 = prog.nodes[n].syms[0];
            let body: i64 = prog.nodes[n].b;
            for (let e: i64 in elements(eval(prog.nodes[n].a, env)?)?) {
                if (boolean(eval(body, bind(x, e, 0, env))?)?) { return e; }
            }
            cx.at = n;
            fail err("CHOOSE found no element that satisfies its condition");
        },
        Op::FnSet => {
            let a: i64 = eval(prog.nodes[n].a, env)?;
            let b: i64 = eval(prog.nodes[n].b, env)?;
            if (!is_set(a) || !is_set(b)) { fail err("[S -> T] of something that is not a set"); }
            return lazy(Tag::FnSet, a, b);
        },
        Op::RecCons | Op::RecSet => {
            let names: string[] = std::copy(prog.nodes[n].strs);
            var vals: i64[] = [];
            let kids: i64[] = std::copy(prog.nodes[n].kids);
            for (let k: i64 in &kids) { vals.push(norm(eval(k, env)?)?); }
            if (op == Op::RecCons) { return mk_rec(&names, &vals)?; }
            for (let v: i64 in &vals) { if (!is_set(v)) { fail err("[a : S] where S is \(show(v)), not a set"); } }
            return mk_recset(&names, &vals)?;
        },
        Op::Except => {
            var f: i64 = eval(prog.nodes[n].a, env)?;
            let items: i64[] = std::copy(prog.nodes[n].kids);
            for (let it: i64 in &items) {
                let path: i64[] = std::copy(prog.nodes[it].kids);
            }
        }
    }
}

// env with node n's LET definitions bound, each in the scope of those before it.
fn let_env(n: i64, env: i64) -> i64 {
    var e: i64 = env;
    let defs: i64[] = std::copy(prog.nodes[n].kids);
    for (let d: i64 in &defs) { e = bind(prog.nodes[d].sym, d, 1, e); }
    return e;
}

// [f EXCEPT ![path[i]]...[path[last]] = v]: v is the item's value, @ the old value. A .f in
// the path is the string "f", as in TLA+.
fn except_at(f: i64, path: &i64[], i: i64, item: i64, env: i64) -> i64 | EvalError {
    let key: i64 = norm(eval(path[i], env)?)?;
    if (!is_tag(f, Tag::Func)) { fail err("EXCEPT on \(show(f)), which is not a function"); }
    if (let old = lookup(f, key)) {
        var v: i64 = 0;
        if (i == path.len - 1) {
            v = norm(eval(prog.nodes[item].b, bind(prog.at, old, 0, env))?)?;
        } else {
            v = except_at(old, path, i + 1, item, env)?;
        }
        return update(f, key, v)?;
    }
    return f;
}

fn global(n: i64) -> i64 | EvalError {
    let s: i64 = prog.nodes[n].sym;
    let g: Global = glob(s);
    match (g.kind) {
        Kind::Var => { return var_value(g.index, false); },
        Kind::Const => { return cx.consts[g.index]; },
        Kind::Builtin => {
            return match (name(s)) {
                "Nat" => lazy(Tag::Nat, 0, 0),
                "Int" => lazy(Tag::Int, 0, 0),
                "STRING" => lazy(Tag::Strings, 0, 0),
                _ => mk_set_sorted([FALSE, TRUE]),
            };
        },
        Kind::Missing => { fail err("internal: \(name(s)) is not defined"); },
        Kind::Def => {
            if (let v = cx.memo.get(s)) { return v; }
            let v: i64 = eval(g.body, -1)?;
            if (constant_def(s)) { cx.memo.put(s, v); }
            return v;
        },
    }
}

// a + b (op 0), a - b (1) or a * b (2), or Overflow.
fn checked(op: i64, a: i64, b: i64) -> i64 | Overflow {
    return match (op) {
        0 => (a + b)?,
        1 => (a - b)?,
        _ => (a * b)?,
    };
}

fn arith(op: Op, a: i64, b: i64) -> i64 | EvalError {
    match (op) {
        Op::Lt => { return mk_bool(a < b); },
        Op::Gt => { return mk_bool(a > b); },
        Op::Le => { return mk_bool(a <= b); },
        Op::Ge => { return mk_bool(a >= b); },
        Op::Plus => {
            match (checked(0, a, b)) {
                v => { return mk_int(v)?; },
                e: Overflow => { fail err("overflow: \(a) + \(b)"); },
            }
        },
        Op::Minus => {
            match (checked(1, a, b)) {
                v => { return mk_int(v)?; },
                e: Overflow => { fail err("overflow: \(a) - \(b)"); },
            }
        },
        Op::Times => {
            match (checked(2, a, b)) {
                v => { return mk_int(v)?; },
                e: Overflow => { fail err("overflow: \(a) * \(b)"); },
            }
        },
        Op::Div | Op::Mod => {
            if (b <= 0) { fail err("\\div and % need a positive divisor, not \(b)"); }
            var q: i64 = a / b;
            if (a % b != 0 && a < 0) { q -= 1; }       // floor, as in TLA+
            if (op == Op::Div) { return mk_int(q)?; }
            return mk_int(a - q * b)?;
        },
        Op::Pow => {
            if (b < 0) { fail err("a negative exponent: \(a)^\(b)"); }
            var r: i64 = 1;
            for (let i: i64 in 0..b) {
                match (checked(2, r, a)) {
                    v => { r = v; },
                    e: Overflow => { fail err("overflow: \(a)^\(b)"); },
                }
            }
            return mk_int(r)?;
        },
        _ => {
            // a..b
            var out: i64[] = [];
            var i: i64 = a;
            if (b - a > 10000000) { fail err("\(a)..\(b) is too large to list"); }
            while (i <= b) {
                out.push(mk_int(i)?);
                i += 1;
            }
            return mk_set_sorted(out);
        },
    }
}

fn seq_arg(v: i64, what: string) -> i64 | EvalError {
    if (!is_seq(v)) { fail err("\(what) of \(show(v)), which is not a sequence"); }
    return v;
}

fn builtin(w: string, args: &i64[]) -> i64 | EvalError {
    match (w) {
        "Len" => { return small(size(seq_arg(args[0], "Len")?)); },
        "Append" => {
            var out: i64[] = ys(seq_arg(args[0], "Append")?);
            out.push(norm(args[1])?);
            return mk_tuple(out);
        },
        "Head" => {
            let s: i64 = seq_arg(args[0], "Head")?;
            if (size(s) == 0) { fail err("Head of <<>>"); }
            return vt.nodes[s >> 1].ys[0];
        },
        "Tail" => {
            let s: i64 = seq_arg(args[0], "Tail")?;
            if (size(s) == 0) { fail err("Tail of <<>>"); }
            let all: i64[] = ys(s);
            return mk_tuple(std::copy(all[1..]));
        },
        "SubSeq" => {
            let s: i64 = seq_arg(args[0], "SubSeq")?;
            let m: i64 = int(args[1])?;
            let k: i64 = int(args[2])?;
            if (m > k) { return mk_tuple([]); }
            if (m < 1 || k > size(s)) { fail err("SubSeq(\(show(s)), \(m), \(k)) is out of range"); }
            let all: i64[] = ys(s);
            return mk_tuple(std::copy(all[m - 1..k]));
        },
        "Seq" => {
            if (!is_set(args[0])) { fail err("Seq of \(show(args[0])), which is not a set"); }
            return lazy(Tag::SeqSet, args[0], 0);
        },
        "Cardinality" => { return small(size(expand(args[0])?)); },
        "IsFiniteSet" => {
            let s: i64 = args[0];
            if (!is_set(s)) { fail err("IsFiniteSet of \(show(s)), which is not a set"); }
            return mk_bool(!(is_tag(s, Tag::Nat) || is_tag(s, Tag::Int) || is_tag(s, Tag::Strings) || is_tag(s, Tag::SeqSet)));
        },
        "Print" => {
            println("\(show(args[0]))  \(show(args[1]))");
            return args[1];
        },
        "PrintT" => {
            println(show(args[0]));
            return TRUE;
        },
        "Assert" => {
            if (!boolean(args[0])?) { fail err("Assert failed: \(show(args[1]))"); }
            return TRUE;
        },
        "ToString" => { return mk_str(show(args[0])); },
        "Permutations" => {
            let s: i64[] = elements(args[0])?;
            if (s.len > 8) { fail err("Permutations of \(s.len) elements is too many"); }
            var out: i64[] = [];
            var perm: i64[] = std::copy(s);
            permute(mut &perm, 0, &s, mut &out)?;
            return mk_set(out);
        },
        _ => { fail err("internal: no builtin \(w)"); },
    }
}

// Every permutation of perm[k..] after perm[..k], as a function from s, into out.
fn permute(mut perm: &i64[], k: i64, s: &i64[], mut out: &i64[]) -> void | EvalError {
    if (k == perm.len) {
        out.push(mk_func(s, perm)?);
        return;
    }
    for (let i: i64 in k..perm.len) {
        let t: i64 = perm[k];
        perm[k] = perm[i];
        perm[i] = t;
        permute(perm, k + 1, s, out)?;
        perm[i] = perm[k];
        perm[k] = t;
    }
}

// The variables UNCHANGED e names: e is a variable, a tuple of them, or a definition of one.
fn unchanged_vars(n: i64, mut out: &i64[]) -> void | EvalError {
    let op: Op = prog.nodes[n].op;
    if (op == Op::Tuple) {
        let kids: i64[] = std::copy(prog.nodes[n].kids);
        for (let k: i64 in &kids) { unchanged_vars(k, out)?; }
        return;
    }
    if (op == Op::Global) {
        let g: Global = glob(prog.nodes[n].sym);
        if (g.kind == Kind::Var) {
            out.push(g.index);
            return;
        }
        if (g.kind == Kind::Def && g.params.len == 0 && g.body >= 0) {
            unchanged_vars(g.body, out)?;
            return;
        }
    }
    cx.at = n;
    fail err("UNCHANGED takes variables, or tuples of them");
}

// ---- Actions ----

// The variable assignment n sets: x' (or x in Init), if n is one and x is unset; else -1.
fn target(n: i64) -> i64 {
    let nd: &Node = &prog.nodes[n];
    var v: i64 = -1;
    if (nd.op == Op::Prime && !cx.init) {
        v = n;
        v = prog.nodes[nd.a].sym;
    } else if (nd.op == Op::Global && cx.init) {
        v = nd.sym;
    } else {
        return -1;
    }
    let g: Global = glob(v);
    if (g.kind != Kind::Var || cx.nxt[g.index] != UNSET) { return -1; }
    return g.index;
}

fn run() -> void | EvalError {
    if (cx.todo.len == 0) { return emit(); }
    let it: Item = cx.todo.pop();
    let outer: string = cx.ctx;
    cx.ctx = it.ctx;
    step(it.node, it.env)?;
    cx.ctx = outer;
    cx.todo.push(it);
}

fn then(n: i64, env: i64) -> void | EvalError {
    cx.todo.push(Item { node: n, env: env, ctx: cx.ctx });
    run()?;
    cx.todo.pop();
}

// One action item: node n in env, then the rest.
fn step(n: i64, env: i64) -> void | EvalError {
    cx.at = n;
    let op: Op = prog.nodes[n].op;
    match (op) {
        Op::And => {
            let kids: i64[] = std::copy(prog.nodes[n].kids);
            var k: i64 = kids.len - 1;
            while (k >= 0) {
                cx.todo.push(Item { node: kids[k], env: env, ctx: cx.ctx });
                k -= 1;
            }
            run()?;
            for (let i: i64 in 0..kids.len) { cx.todo.pop(); }
            return;
        },
        Op::Or => {
            let kids: i64[] = std::copy(prog.nodes[n].kids);
            for (let k: i64 in &kids) { then(k, env)?; }
            return;
        },
        Op::Exists => {
            let syms: i64[] = std::copy(prog.nodes[n].syms);
            let sets: i64[][] = bound_sets(n, env)?;
            if (any_empty(&sets)) { return; }
            var pick: i64[syms.len];
            while (true) {
                then(prog.nodes[n].b, bind_pick(&syms, &sets, &pick, env))?;
                if (!advance(mut &pick, &sets)) { break; }
            }
            return;
        },
        Op::Eq => {
            let v: i64 = target(prog.nodes[n].a);
            if (v >= 0) {
                cx.nxt[v] = storable(eval(prog.nodes[n].b, env)?)?;
                let fixed: bool = fix_label();
                run()?;
                if (fixed) { unfix_label(); }
                cx.nxt[v] = UNSET;
                return;
            }
        },
        Op::In => {
            let v: i64 = target(prog.nodes[n].a);
            if (v >= 0) {
                let fixed: bool = fix_label();
                for (let e: i64 in elements(eval(prog.nodes[n].b, env)?)?) {
                    cx.nxt[v] = storable(e)?;
                    run()?;
                }
                if (fixed) { unfix_label(); }
                cx.nxt[v] = UNSET;
                return;
            }
        },
        Op::Unchanged => {
            if (cx.init) { fail err("UNCHANGED in Init"); }
            var vars: i64[] = [];
            unchanged_vars(prog.nodes[n].a, mut &vars)?;
            var set: i64[] = [];
            var ok: bool = true;
            for (let i: i64 in &vars) {
                if (cx.nxt[i] == UNSET) {
                    cx.nxt[i] = cx.cur[i];
                    set.push(i);
                } else if (cx.nxt[i] != cx.cur[i]) {
                    ok = false;
                }
            }
            var fixed: bool = false;
            if (set.len > 0) { fixed = fix_label(); }
            if (ok) { run()?; }
            if (fixed) { unfix_label(); }
            for (let i: i64 in &set) { cx.nxt[i] = UNSET; }
            return;
        },
        Op::If => {
            if (boolean(eval(prog.nodes[n].a, env)?)?) {
                then(prog.nodes[n].b, env)?;
            } else {
                then(prog.nodes[n].c, env)?;
            }
            return;
        },
        Op::Case => {
            let arms: i64[] = std::copy(prog.nodes[n].kids);
            for (let arm: i64 in &arms) {
                if (boolean(eval(prog.nodes[arm].a, env)?)?) {
                    then(prog.nodes[arm].b, env)?;
                    return;
                }
            }
            if (prog.nodes[n].c >= 0) {
                then(prog.nodes[n].c, env)?;
                return;
            }
            cx.at = n;
            fail err("no CASE arm applies, and there is no OTHER");
        },
        Op::Let => {
            then(prog.nodes[n].b, let_env(n, env))?;
            return;
        },
        Op::Global => {
            let s: i64 = prog.nodes[n].sym;
            let g: Global = glob(s);
            if (g.kind == Kind::Def && !constant_def(s)) {
                let outer: string = cx.ctx;
                cx.ctx = name(s);
                then(g.body, -1)?;
                cx.ctx = outer;
                return;
            }
        },
        Op::Call => {
            let s: i64 = prog.nodes[n].sym;
            if (prog.nodes[n].num == 1) {
                let args: i64[] = eval_args(n, env)?;
                let e: i64 = find_env(s, env);
                let d: i64 = cx.envs.vals[e];
                let params: i64[] = std::copy(prog.nodes[d].syms);
                then(prog.nodes[d].b, call_env(&params, &args, cx.envs.parents[e]))?;
                return;
            }
            let g: Global = glob(s);
            if (g.kind == Kind::Def) {
                let args: i64[] = eval_args(n, env)?;
                if (g.body < 0) { fail err("\(name(s)) is declared RECURSIVE but never defined"); }
                var parts: string = "";
                for (let i: i64, let a: i64 in &args) {
                    if (i > 0) { parts = "\(parts), "; }
                    var shown: string = show(a);
                    if (shown.len > 48) { shown = "\(shown[0..45])..."; }
                    parts = "\(parts)\(shown)";
                }
                let outer: string = cx.ctx;
                cx.ctx = "\(name(s))(\(parts))";
                then(g.body, call_env(&g.params, &args, -1))?;
                cx.ctx = outer;
                return;
            }
        },
        Op::Local => {
            let e: i64 = find_env(prog.nodes[n].sym, env);
            if (e >= 0 && cx.envs.kinds[e] == 1) {
                then(prog.nodes[cx.envs.vals[e]].b, cx.envs.parents[e])?;
                return;
            }
        },
        _ => {},
    }
    // A condition on what is set so far.
    if (boolean(eval(n, env)?)?) { run()?; }
}

// Sets the label if this is the state's first variable set: the innermost definition the
// assignment is in (TLC names a step by its action). Items carry it (Item.ctx) because the rest
// of an action runs inside each step, so what is "open" is not where a node is written. Returns
// whether it did, for unfix_label.
fn fix_label() -> bool {
    if (cx.fixed) { return false; }
    cx.fixed = true;
    if (cx.ctx.len > 0) { cx.label = cx.ctx; } else { cx.label = "Next"; }
    return true;
}

fn unfix_label() -> void {
    cx.fixed = false;
    cx.label = "";
}

fn emit() -> void | EvalError {
    for (let i: i64 in 0..cx.nxt.len) {
        if (cx.nxt[i] == UNSET) {
            var tick: string = "'";
            if (cx.init) { tick = ""; }
            fail err("a state where \(name(prog.vars[i]))\(tick) is never set");
        }
    }
    cx.found.push(mk_tuple(std::copy(cx.nxt)));
    cx.labels.push(cx.label);
}

fn unset_all() -> void {
    for (let i: i64 in 0..cx.nxt.len) { cx.nxt[i] = UNSET; }
}

/// The initial states action init allows, into cx.found.
export fn initial(init: i64) -> void | EvalError {
    cx.found = [];
    cx.labels = [];
    cx.init = true;
    unset_all();
    cx.label = "Initial predicate";
    cx.fixed = true;
    cx.ctx = "";
    then(init, -1)?;
    cx.init = false;
    cx.fixed = false;
}

/// The states action act leads to from state (a tuple of the variables), into cx.found.
export fn successors(state: i64, act: i64) -> void | EvalError {
    cx.found = [];
    cx.labels = [];
    cx.cur = ys(state);
    unset_all();
    cx.label = "";
    cx.fixed = false;
    cx.ctx = "";
    reset_envs();
    // Open Next here so the label is the action within it.
    var root: i64 = act;
    if (prog.nodes[act].op == Op::Global) {
        let g: Global = glob(prog.nodes[act].sym);
        if (g.kind == Kind::Def) { root = g.body; }
    }
    then(root, -1)?;
}

/// The states action act leads to from state, with syms bound to vals: a fairness condition's
/// action, possibly under a \A (\A r \in R : WF_vars(Send(r))).
export fn successors_with(state: i64, act: i64, syms: &i64[], vals: &i64[]) -> void | EvalError {
    cx.found = [];
    cx.labels = [];
    cx.cur = ys(state);
    unset_all();
    cx.label = "";
    cx.fixed = false;
    cx.ctx = "";
    reset_envs();
    var env: i64 = -1;
    for (let i: i64 in 0..syms.len) { env = bind(syms[i], vals[i], 0, env); }
    then(act, env)?;
}

/// The value of constant expression n, with syms bound to vals: the set a \A ranges over.
export fn eval_with(n: i64, syms: &i64[], vals: &i64[]) -> i64 | EvalError {
    reset_envs();
    var env: i64 = -1;
    for (let i: i64 in 0..syms.len) { env = bind(syms[i], vals[i], 0, env); }
    return eval(n, env);
}

/// Whether the predicate p holds in state.
export fn holds(state: i64, p: i64) -> bool | EvalError {
    cx.cur = ys(state);
    cx.init = false;
    reset_envs();
    return boolean(eval(p, -1)?);
}
